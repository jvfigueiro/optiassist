<Application x:Class="OptiAssist.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Cores do Tema Escuro Moderno (estilo Windows 11 Fluent) -->
        <Color x:Key="ColorBgPrimary">#18181B</Color>
        <Color x:Key="ColorBgSidebar">#121214</Color>
        <Color x:Key="ColorBgCard">#222228</Color>
        <Color x:Key="ColorBorderCard">#33333D</Color>
        <Color x:Key="ColorCardHover">#2C2C36</Color>

        <Color x:Key="ColorAccent">#0EA5E9</Color>
        <Color x:Key="ColorAccentHover">#38BDF8</Color>
        <Color x:Key="ColorAccentPressed">#0284C7</Color>

        <Color x:Key="ColorSuccess">#10B981</Color>
        <Color x:Key="ColorWarning">#F59E0B</Color>
        <Color x:Key="ColorDanger">#EF4444</Color>

        <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
        <Color x:Key="ColorTextSecondary">#94A3B8</Color>
        <Color x:Key="ColorTextMuted">#64748B</Color>

        <Color x:Key="ColorConsoleBg">#0C0C0F</Color>
        <Color x:Key="ColorConsoleText">#E2E8F0</Color>

        <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}"/>
        <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}"/>
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
        <SolidColorBrush x:Key="BrushBorderCard" Color="{StaticResource ColorBorderCard}"/>
        <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}"/>

        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
        <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}"/>

        <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
        <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
        <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>

        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

        <SolidColorBrush x:Key="BrushConsoleBg" Color="{StaticResource ColorConsoleBg}"/>
        <SolidColorBrush x:Key="BrushConsoleText" Color="{StaticResource ColorConsoleText}"/>

        <!-- Brushes de Controles para Alternância Dinâmica de Tema (Claro / Escuro) -->
        <SolidColorBrush x:Key="BrushBtnBg" Color="#2A2A34"/>
        <SolidColorBrush x:Key="BrushBtnHover" Color="#383848"/>
        <SolidColorBrush x:Key="BrushBtnBorderHover" Color="#4B4B5E"/>
        <SolidColorBrush x:Key="BrushBtnPressed" Color="#202028"/>
        <SolidColorBrush x:Key="BrushNavHover" Color="#1A1A22"/>
        <SolidColorBrush x:Key="BrushNavChecked" Color="#202430"/>
        <SolidColorBrush x:Key="BrushInputBg" Color="#1C1C22"/>

        <!-- Estilo Padrão para TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Estilo Padrão para Botões Neutros -->
        <Style x:Key="BtnDefault" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushBtnBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botão de Ação / Destaque (Accent) -->
        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnDefault}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botão de Alerta / BIOS (Danger) -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnDefault}">
            <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F87171"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botões de Navegação da Sidebar -->
        <Style x:Key="BtnNav" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource BrushNavChecked}"/>
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>

        <!-- Estilo para CheckBoxes -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Application.Resources>
</Application>
