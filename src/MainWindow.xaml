                                            <TextBox x:Name="txtNewAppWingetId" Height="26" ToolTip="Identificador do pacote no repositório Winget" />
                                        </StackPanel>

                                        <!-- Add / Save and Cancel Buttons -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <Button x:Name="btnAddCustomApp"
                                                    Content="➕ Adicionar"
                                                    Style="{StaticResource BtnAccent}"
                                                    Height="26"
                                                    Padding="12,0"
                                                    Margin="0,0,4,0"
                                                    Click="BtnAddCustomApp_Click" />
                                            <Button x:Name="btnCancelEditApp"
                                                    Content="✕"
                                                    Style="{StaticResource BtnDefault}"
                                                    Height="26"
                                                    Width="26"
                                                    Visibility="Collapsed"
                                                    ToolTip="Cancelar edição"
                                                    Click="BtnCancelEditApp_Click" />
                                        </StackPanel>

                                        <!-- Row 2: Automate and Silent Arguments -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                            <CheckBox x:Name="chkNewAppPreSelected"
                                                      Content="Automatizar por padrão"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0" />
                                            <TextBlock x:Name="txtNewAppSilentLabel" Text="Argumentos silenciosos (opcional):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="txtNewAppSilentArgs" Width="180" Height="24" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- autoinstall.json Programs List for Editing -->
                                <TextBlock x:Name="txtCurrentListTitle"
                                           Text="Programas na lista atual:"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Margin="0,0,0,4" />

                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        MaxHeight="190">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icCustomAppsEditorList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="0,0,0,1" Padding="4,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayTypeInfo}"
                                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <CheckBox Grid.Column="2"
                                                                      Content="Automatizar"
                                                                      IsChecked="{Binding PreSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DetailInfo}"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="▲"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnMoveAppUp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Mover para cima / Move up" />
                                                                <Button Content="▼"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnMoveAppDown_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Mover para baixo / Move down" />
                                                                <Button Content="✏"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnEditCustomApp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Editar / Edit" />
                                                                <Button Content="🗑"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,0,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnRemoveCustomApp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Remover / Remove" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Editor Footer Actions -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button x:Name="btnSaveCustomApps"
                                                Content="💾 Salvar Alterações"
                                                Style="{StaticResource BtnAccent}"
                                                Margin="0,0,6,0"
                                                Click="BtnSaveCustomApps_Click" />
                                        <Button x:Name="btnResetDefaultApps"
                                                Content="🔄 Restaurar Lista Padrão"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnResetDefaultApps_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="btnOpenPostInstallJson"
                                                Content="📂 Abrir autoinstall.json"
                                                Style="{StaticResource BtnDefault}"
                                                Click="BtnOpenPostInstallJson_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: AUTOMATED APPLICATION INSTALLATION LIST -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Installation Section Header -->
                                <TextBlock x:Name="txtAppsInstallCardTitle"
                                           Text="📦 Instalação Automatizada de Aplicativos"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtAppsInstallCardSub"
                                           Text="Selecione os programas que deseja instalar automaticamente em lote no computador:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"/>

                                <!-- ScrollViewer List -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        MaxHeight="260"
                                        Margin="0,0,0,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="0,0,0,1" Padding="6,7">
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Installation Progress Bar -->
                                <ProgressBar x:Name="pbInstallProgress"
                                             Height="6"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Stretch"
                                             Foreground="{DynamicResource BrushAccent}"
                                             Background="{DynamicResource BrushBgPrimary}"
                                             BorderThickness="0"/>

                                <!-- Action Buttons at Screen Bottom -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnSelectEssentials"
                                                Content="Selecionar Essenciais"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnSelectEssentials_Click"/>
                                        <Button x:Name="btnDeselectAll"
                                                Content="Desmarcar Todos"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnDeselectAll_Click"/>
                                        <Button x:Name="btnToggleCustomizePostInstall"
                                                Content="⚙️ Personalizar Instalação Automatizada"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnToggleCustomizePostInstall_Click"/>
                                        <Button x:Name="btnOpenPostInstallFolder"
                                                Content="📂 Pasta de Instaladores"
                                                Style="{StaticResource BtnDefault}"
                                                Click="BtnOpenPostInstallFolder_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnRunInstallSelected"
                                                Content="🚀 Instalar Selecionados"
                                                Style="{StaticResource BtnAccent}"
                                                Padding="16,0"
                                                Height="30"
                                                Click="BtnInstallSelected_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 2: OPTIMIZATION                             -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelOptimization" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtOptTitle"
                                       Text="Otimização do Sistema"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtOptSubtitle"
                                       Text="Ferramentas avançadas de limpeza, integridade do Windows, scripts comunitários e benchmark"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Community Tools Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtCommSectionTitle"
                                           Text="🚀 Ferramentas da Comunidade"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="2" Margin="0,0,0,0">
                                    <Button x:Name="btnChrisTitusOpt"
                                            Content="🚀 Chris Titus Tool (WinUtil)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnChrisTitus_Click"/>
                                    <Button x:Name="btnMassgraveOpt"
                                            Content="🔑 Ativação Massgrave (MAS)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnMassgrave_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 2-Column Grid for Tools (Integrity on Left, Cleanup & Performance on Right) -->
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: System Integrity & Repairs -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,4,8"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="txtIntegrityTitle"
                                               Text="🛡️ Integridade do Sistema e Correções"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnSfc"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnSfcRepair_Click"
                                            ToolTip="Verificar e Reparar Integridade do Windows via SFC (sfc /scannow)">
                                        <TextBlock x:Name="txtBtnSfcText"
                                                   Text="🛡️ Verificar e Reparar Integridade do Windows via SFC"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnDism"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnDismRepair_Click"
                                            ToolTip="Verificar e Reparar Integridade do Windows via DISM (Dism /Online /Cleanup-Image /RestoreHealth)">
                                        <TextBlock x:Name="txtBtnDismText"
                                                   Text="🔧 Verificar e Reparar Integridade do Windows via DISM"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnChkdsk"
                                            Content="🔍 Verificar Integridade do Disco (CHKDSK C:)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnChkdsk_Click"/>
                                    <Button x:Name="btnPrinterFix"
                                            Content="🖨️ Correção de problema de impressoras em rede"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnFixPrinter_Click"/>
                                    <Button x:Name="btnDualBoot"
                                            Content="🕒 Correção de hora do sistema para instalação dual boot"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnDualBootClock_Click"/>
                                    <Button x:Name="btnStoreFix"
                                            Content="🏪 Instalar ou Reparar a Microsoft Store"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnWsReset_Click"/>
                                    <Button x:Name="btnNetReset"
                                            Content="🌐 Redefinição da Rede"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnResetNetwork_Click"/>
                                    <Button x:Name="btnWinSat"
                                            Content="📊 Benchmark WinSAT"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnWinSatBenchmark_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Column: Cleanup & Performance -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="4,0,0,8"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="txtCleanupTitle"
                                               Text="🧹 Limpeza &amp; Desempenho"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnTempClean"
                                            Content="🧹 Limpar Arquivos Temporários"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCleanTemp_Click"/>
                                    <Button x:Name="btnUpdateClean"
                                            Content="🧼 Limpar Cache do Windows Update"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCleanUpdate_Click"/>
                                    <Button x:Name="btnVisualEffects"
                                            Content="⚡ Otimizar Efeitos Visuais"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnVisualFX_Click"/>
                                    <Button x:Name="btnTelemetry"
                                            Content="🔇 Desativar Telemetria e Otimizar Serviços do Sistema"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnTelemetry_Click"/>
                                    <Button x:Name="btnCompactOs"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCompactOs_Click"
                                            ToolTip="Compactar Instalação do Windows (compact.exe /CompactOS:always) - Reduz o espaço ocupado pelo Windows em disco">
                                        <TextBlock x:Name="txtBtnCompactOsText"
                                                   Text="🗜️ Compactar Instalação do Windows"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnOpenScriptsFolder"
                                            Content="📂 Abrir Pasta Scripts"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnOpenScriptsFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 3: WINDOWS TOOLS                            -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelShortcuts" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtToolsTitle"
                                       Text="Ferramentas do Windows"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtToolsSubtitle"
                                       Text="Acesso imediato às ferramentas administrativas nativas do Windows e utilitários portáteis"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Administrative Tools Grid -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtAdminToolsTitle"
                                           Text="🪟 Ferramentas Administrativas"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="3" Margin="0,0,0,0">
                                    <Button x:Name="btnDevMgmtTool" Content="🔌 Gerenciador de Dispositivos" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDevMgmt_Click"/>
                                    <Button x:Name="btnNetplwiz" Content="👤 Contas de Usuário Legado" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNetplwiz_Click"/>
                                    <Button x:Name="btnDiskMgmt" Content="💾 Gerenciamento de Disco" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDiskMgmt_Click"/>
                                    <Button x:Name="btnControl" Content="⚙️ Painel de Controle Clássico" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnControlPanel_Click"/>
                                    <Button x:Name="btnMsinfo" Content="ℹ️ Informações do Sistema" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsInfo_Click"/>
                                    <Button x:Name="btnWinver" Content="📋 Sobre o Windows" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnWinver_Click"/>
                                    <Button x:Name="btnMsconfig" Content="🔧 Ferramenta MSCONFIG" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsConfig_Click"/>
                                    <Button x:Name="btnSysDmTool" Content="💻 Propriedades do Sistema" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnSysDm_Click"/>
                                    <Button x:Name="btnNcpa" Content="🌐 Conexões de Rede" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNcpa_Click"/>
                                    <Button x:Name="btnOptionalFeatures" Content="📦 Recursos do Windows" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnOptionalFeatures_Click"/>
                                    <Button x:Name="btnRegedit" Content="🔑 Editor de Registro" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnRegedit_Click"/>
                                    <Button x:Name="btnTaskmgr" Content="📊 Gerenciador de Tarefas" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnTaskMgr_Click"/>
                                    <Button x:Name="btnResmon" Content="⚡ Monitor de Recursos" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnResmon_Click"/>
                                    <Button x:Name="btnMemoryDiagTool" Content="🧠 Diagnóstico de Memória" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMemoryDiag_Click"/>
                                    <Button x:Name="btnRelMon" Content="📈 Monitor de Confiabilidade" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnReliability_Click"/>
                                    <Button x:Name="btnEventVwr" Content="📑 Visualizador de Eventos" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnEventVwr_Click"/>
                                    <Button x:Name="btnGpedit" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnGpedit_Click"
                                            ToolTip="Editor de Política de Grupo (gpedit.msc) - Disponível apenas nas edições Windows Pro e Enterprise">
                                        <TextBlock x:Name="txtBtnGpeditText"
                                                   Text="📜 Ferramenta GPEDIT (Pro/Enterprise)"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Maintenance Tools Folder button positioned directly below Administrative Tools -->
                        <Button x:Name="btnOpenMaintenanceFolderTool"
                                Content="📂 Pasta de Ferramentas de Manutenção"
                                Style="{StaticResource BtnDefault}"
                                Height="36"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnOpenMaintenanceFolder_Click"
                                ToolTip="Acessar a pasta local Maintenance com as ferramentas portáteis"/>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 4: MAINTENANCE REPORT                      -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelReport" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtReportTitle"
                                       Text="Registrar Ordem de Manutenção"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtReportSub"
                                       Text="Gera um laudo com especificações da máquina, placa-mãe, número de série e procedimentos"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Report Form -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Service and Device Details -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtReportOrderLabel" Text="Nº da Ordem de Serviço:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportOrder" Height="26"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtReportClientLabel" Text="Nome do Cliente:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportClient" Height="26"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="txtReportSerialLabel" Text="Nº de Série / Service Tag:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportSerial" Height="26"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Services Checklist (ALL UNCHECKED BY DEFAULT) -->
                                <TextBlock x:Name="txtChecklistLabel" Text="Checklist de Procedimentos Realizados:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox x:Name="chkActSmart" Content="Diagnóstico e saúde de disco (SMART)" IsChecked="False"/>
                                    <CheckBox x:Name="chkActClean" Content="Limpeza interna preventiva e pasta térmica" IsChecked="False"/>
                                    <CheckBox x:Name="chkActFormat" Content="Formatação e instalação limpa do Windows" IsChecked="False"/>
                                    <CheckBox x:Name="chkActDrivers" Content="Atualização completa de drivers e BIOS" IsChecked="False"/>
                                    <CheckBox x:Name="chkActApps" Content="Instalação de programas essenciais" IsChecked="False"/>
                                    <CheckBox x:Name="chkActTemp" Content="Limpeza profunda de arquivos temporários" IsChecked="False"/>
                                    <CheckBox x:Name="chkActDism" Content="Reparo de integridade (DISM / SFC)" IsChecked="False"/>
                                    <CheckBox x:Name="chkActNet" Content="Configuração de rede e impressoras" IsChecked="False"/>
                                </UniformGrid>

                                <!-- Technical Assessment with Suggestive Placeholder -->
                                <TextBlock x:Name="txtReportNotesLabel" Text="Laudo Técnico e Observações:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtReportNotes"
                                         Height="50"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="Você pode informar maiores detalhes acerca do que foi realizado neste equipamento aqui..."
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         GotFocus="TxtReportNotes_GotFocus"
                                         Margin="0,0,0,8"/>

                                <!-- Report Actions -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSaveReport"
                                            Content="📄 Gerar Registro de Manutenção"
                                            Style="{StaticResource BtnAccent}"
                                            Margin="0,0,8,0"
                                            Click="BtnSaveReport_Click"/>
                                    <Button x:Name="btnCopyReport"
                                            Content="📋 Copiar Laudo Técnico"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,8,0"
                                            Click="BtnCopyReport_Click"/>
                                    <Button x:Name="btnOpenReportFolder"
                                            Content="📂 Abrir Pasta Reports"
                                            Style="{StaticResource BtnDefault}"
                                            Click="BtnOpenReportFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 5: SETTINGS                                -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelSettings" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtSettingsTitle"
                                       Text="Configurações do OptiAssist"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtSettingsSub"
                                       Text="Dados salvos em Config\settings.json no pen drive"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Service Provider Mode -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="chkServiceProviderMode"
                                                  Content="Modo prestador de serviço"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Checked="ChkServiceProviderMode_Changed"
                                                  Unchecked="ChkServiceProviderMode_Changed"/>
                                        <TextBlock x:Name="txtServiceProviderDesc"
                                                   Text="Habilita personalização da marca e opções para atendimento e laudo técnico"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="24,2,0,0"/>

                                        <!-- Section with Custom App Name, Contact Info and Enable Maintenance Report -->
                                        <StackPanel x:Name="pnlServiceProviderFields" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="txtStoreNameLabel" Text="Nome personalizado do aplicativo:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtSettingStore" Height="26" ToolTip="Customize a aplicação de acordo com o nome que você preferir."/>
                                            <TextBlock x:Name="txtStoreNameHint" Text="💡 Customize a aplicação de acordo com o nome que você preferir." FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,8"/>

                                            <TextBlock x:Name="txtPhoneLabel" Text="Informações de Contato:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtSettingPhone" Height="26" ToolTip="Informe um e-mail, número de contato ou rede social que preferir"/>
                                            <TextBlock x:Name="txtPhoneHint" Text="💡 Informe um e-mail, número de contato ou rede social que preferir" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,8"/>

                                            <CheckBox x:Name="chkEnableMaintenanceReport"
                                                      Content="Habilitar Registro de Manutenção"
                                                      FontWeight="SemiBold"
                                                      Margin="0,4,0,2"
                                                      Checked="ChkEnableMaintenanceReport_Changed"
                                                      Unchecked="ChkEnableMaintenanceReport_Changed"/>
                                            <TextBlock x:Name="txtEnableReportDesc"
                                                       Text="Exibe ou oculta a tela de Registrar Manutenção no menu lateral da aplicação"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="24,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="txtReportPathLabel" Text="Caminho Padrão do Arquivo de Relatório:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtSettingReportPath" Height="26" Margin="0,0,0,8"/>

                                <!-- Language Selection Buttons -->
                                <TextBlock x:Name="txtLangLabel" Text="Idioma da Aplicação (Language):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="btnLangPt"
                                            Content="🇧🇷 Português (Brasil)"
                                            Style="{StaticResource BtnDefault}"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Click="BtnLangPt_Click"/>
                                    <Button x:Name="btnLangEn"
                                            Content="🇺🇸 English (US)"
                                            Style="{StaticResource BtnDefault}"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Click="BtnLangEn_Click"/>
                                    <TextBlock x:Name="lblCurrentLanguage"
                                               Text="Atual: Português (pt-BR)"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="chkSettingWinget"
                                          Content="Habilitar download via Winget quando o programa não existir na pasta PostInstall"
                                          Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkSettingAutoRefresh"
                                          Content="Atualizar especificações de hardware automaticamente na inicialização"
                                          Margin="0,2,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSaveSettings"
                                            Content="💾 Salvar Configurações"
                                            Style="{StaticResource BtnAccent}"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,0"
                                            Click="BtnSaveSettings_Click"/>
                                    <Button x:Name="btnResetSettings"
                                            Content="🔄 Restaurar Padrões"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnResetSettings_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Application Customization (Colors and Accents) -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtPersonalizeTitle"
                                           Text="🎨 Personalizar o Aplicativo"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtPersonalizeSub"
                                           Text="Personalize o tema visual, as cores dos botões principais e acentos do OptiAssist:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Light Mode / Dark Mode Toggle -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="txtThemeLabel" Text="Tema Visual:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <Button x:Name="btnToggleTheme"
                                            Style="{StaticResource BtnDefault}"
                                            Height="30"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="Alternar entre modo escuro e modo claro"
                                            Click="BtnToggleTheme_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtThemeIcon" Text="☀️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtThemeText" Text="Modo Claro" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Row: Hex Code + Color Picker + Apply Button + Preview -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hexadecimal Input Field -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtAccentLabel" Text="Código de cor hexadecimal:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtSettingAccentColor" Text="#0EA5E9" Height="28" TextChanged="TxtSettingAccentColor_TextChanged"/>
                                    </StackPanel>

                                    <!-- Color Picker Dialog Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,8,0">
                                        <Button x:Name="btnOpenColorDialog"
                                                Content="🎨 Seletor de Cores..."
                                                Style="{StaticResource BtnDefault}"
                                                Height="28"
                                                Padding="10,0"
                                                ToolTip="Abrir o seletor visual de cores do Windows"
                                                Click="BtnOpenColorDialog_Click"/>
                                    </StackPanel>

                                    <!-- Apply Color Button -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <Button x:Name="btnApplyCustomColor"
                                                Content="✔️ Aplicar Cor"
                                                Style="{StaticResource BtnAccent}"
                                                Height="28"
                                                Padding="12,0"
                                                ToolTip="Aplicar a cor informada imediatamente ao OptiAssist"
                                                Click="BtnApplyCustomColor_Click"/>
                                    </StackPanel>

                                    <!-- Preview Box -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtPreviewLabel"
                                                   Text="Pré-visualização: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <Border x:Name="borderPreviewColor"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushAccent}"
                                                BorderBrush="{DynamicResource BrushBorderCard}"
                                                BorderThickness="1"
                                                ToolTip="Cor de destaque atual"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Preset Color Palette -->
                                <TextBlock x:Name="txtPresetLabel" Text="Cores Sugeridas:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="btnPresetBlue" Content="🔵 Azul (Padrão)" Tag="#0EA5E9" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetGreen" Content="🟢 Verde claro" Tag="#10B981" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPurple" Content="🟣 Roxo" Tag="#8B5CF6" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetOrange" Content="🟠 Laranja" Tag="#F97316" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetRed" Content="🔴 Vermelho" Tag="#FF4444" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetYellow" Content="🟡 Amarelo" Tag="#F59E0B" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPink" Content="🌸 Rosa" Tag="#FC4899" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 6: ABOUT THE APPLICATION                    -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelAbout" Visibility="Collapsed" Margin="4">
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,12" VerticalAlignment="Center">
                            <TextBlock x:Name="txtAboutTitle"
                                       Text="ℹ️ Sobre o OptiAssist"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtAboutSub"
                                       Text="Informações de versão, termos de licença de código aberto e canais oficiais"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Main License and Information Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="OptiAssist v1.0.0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Copyright (C) 2026 João Figueiró"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Margin="0,0,0,12"/>

                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <TextBlock TextWrapping="Wrap"
                                               FontFamily="Consolas, Lucida Console, Segoe UI"
                                               FontSize="11"
                                               LineHeight="18"
                                               Foreground="{DynamicResource BrushTextSecondary}">
This program is free software: you can redistribute it and/or modify 
it under the terms of the GNU General Public License as published by 
the Free Software Foundation, either version 3 of the License, or 
(at your option) any later version.

This program is distributed in the hope that it will be useful, 
but WITHOUT ANY WARRANTY; without even the implied warranty of 
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the 
GNU General Public License for more details.

You should have received a copy of the GNU General Public License 
along with this program. If not, see &lt;https://www.gnu.org/licenses/&gt;.
                                    </TextBlock>
                                </Border>

                                <!-- Official Links / Buttons -->
                                <WrapPanel>
                                    <Button x:Name="btnAboutGithub"
                                            Content="🐙 Repositório GitHub"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutGithub_Click"/>
                                    <Button x:Name="btnAboutWebsite"
                                            Content="🌐 Site Oficial"
                                            Style="{StaticResource BtnAccent}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutWebsite_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

                <!-- ======================================================== -->
                <!-- DEDICATED TAB: OUTPUT TERMINAL & COMMAND EXECUTION       -->
                <!-- ======================================================== -->
                <Grid x:Name="panelTerminal"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top: Header with Title and Actions -->
                        <RowDefinition Height="*" />    <!-- Center: Monospace Console -->
                    </Grid.RowDefinitions>

                    <!-- Top: Title & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLogsTitle"
                                       Text="⬛ Logs"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtLogsSub"
                                       Text="Histórico em tempo real de diagnósticos, scripts e execuções do sistema"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnExportLog"
                                    Content="💾 Exportar Log"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnSaveLog_Click"/>
                            <Button x:Name="btnCopyAllLog"
                                    Content="📋 Copiar Tudo"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnCopyLog_Click"/>
                            <Button x:Name="btnClearLog"
                                    Content="🗑️ Limpar Console"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Center: Monospace Console / Terminal Window -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushConsoleBg}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox x:Name="txtConsoleLog"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Lucida Console, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushConsoleText}"
                                 BorderThickness="0"
                                 Padding="12,10"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: BOTTOM STATUS BAR                                 -->
        <!-- BitLocker | TPM | Secure Boot                            -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
            Background="{DynamicResource BrushBgSidebar}"
            BorderBrush="{DynamicResource BrushBorderCard}"
            BorderThickness="0,1,0,0"
            Padding="14,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. BitLocker -->
                <TextBlock x:Name="txtBitLockerLabel"
                           Text="🔒 BitLocker: "
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtBitLockerStatus"
                           Text="Consultando..."
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"/>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 2. TPM -->
                <TextBlock x:Name="txtTpmLabel"
                           Text="🛡️ TPM: "
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTpmStatus"
                           Text="Consultando..."
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"/>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 3. Secure Boot -->
                <TextBlock x:Name="txtSecureBootLabel"
                           Text="⚡ Secure Boot: "
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSecureBootStatus"
                           Text="Consultando..."
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right Side: Custom Application Name -->
            <TextBlock x:Name="lblFooterStoreName"
                       Grid.Column="1"
                       Text="N/A"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Grid>
</Window>
