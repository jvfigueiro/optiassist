<Window x:Class="OptiAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiAssist"
        Icon="app.ico"
        Width="1000" Height="620"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgPrimary}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <!-- MAIN GRID (Row 0: Top Header Bar, Row 1: Workspace, Row 2: Bottom Status Bar) -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52" /> <!-- Row 0: Top Header Bar -->
            <RowDefinition Height="*" />                   <!-- Row 1: Workspace (Sidebar + Content Area) -->
            <RowDefinition Height="28" />                  <!-- Row 2: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP HEADER BAR                                    -->
        <!-- Left: OptiAssist Branding | Right: Hardware Specs       -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushBgSidebar}"
                BorderBrush="{DynamicResource BrushBorderCard}"
                BorderThickness="0,0,0,1"
                Padding="16,6,16,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Left: Logo & Branding -->
                    <ColumnDefinition Width="*" />    <!-- Flexible middle spacing -->
                    <ColumnDefinition Width="Auto" /> <!-- Right: Quick Hardware Specifications -->
                </Grid.ColumnDefinitions>

                <!-- Top Left: Application Branding (Logo + Title) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.png"
                           Width="28"
                           Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblAppTitle"
                               Text="OptiAssist"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Top Right: Clean Hardware Specifications -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Line 1: Motherboard (Manufacturer and Model) -->
                    <TextBlock x:Name="lblHeaderDevice"
                               Text="Detecting..."
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450"
                               HorizontalAlignment="Right"
                               ToolTip="Motherboard Model"/>

                    <!-- Line 2: Processor and RAM -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <TextBlock x:Name="lblHeaderCpu"
                                   Text="Processor: ..."
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="340"
                                   ToolTip="Processor"/>
                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="6,0"/>
                        <TextBlock x:Name="lblHeaderRam"
                                   Text="RAM: ..."
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"
                                   ToolTip="Total RAM Memory"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: WORKSPACE (Sidebar + Content Area) -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" /> <!-- Column 0: Fixed Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Column 1: Dynamic Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (Width="200")            -->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushBgSidebar}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="0,0,1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <!-- Navigation Buttons -->
                    <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                        <RadioButton x:Name="rbNavDashboard"
                                     Content="💻  Dashboard"
                                     Style="{StaticResource BtnNav}"
                                     IsChecked="True"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavPostInstall"
                                     Content="📦  App Manager"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavOptimization"
                                     Content="⚡  Optimization"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavShortcuts"
                                     Content="🛠️  Windows Tools"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavReport"
                                     Content="📋  Maintenance Report"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavTerminal"
                                     Content="⬛  Logs"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavSettings"
                                     Content="⚙️  Settings"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                        <RadioButton x:Name="rbNavAbout"
                                     Content="ℹ️  About"
                                     Style="{StaticResource BtnNav}"
                                     Click="NavButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- COLUMN 1: CONTENT AREA                     -->
            <!-- ========================================== -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- ======================================================== -->
                <!-- MAIN CONTENT (Central ScrollViewer for tabs)            -->
                <!-- ======================================================== -->
                <ScrollViewer x:Name="scrollViewerContent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="8,4,8,4">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- ================================================ -->
                    <!-- TAB 0: OVERVIEW (DASHBOARD)                      -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelDashboard" Visibility="Visible" Margin="4">
                        <!-- Section Header -->
                        <StackPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock x:Name="txtDashboardTitle"
                                       Text="Welcome to OptiAssist!"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtDashboardSubtitle"
                                       Text="The ultimate tool to keep your system in shape"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- 2-Block Grid per Row: Hardware Specs (Left) and Operating System (Right) -->
                        <Grid Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Block: Hardware Specifications -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="txtHwCardTitle"
                                               Text="🧠 Hardware Information"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 1 per row in strict order: Processor, RAM, GPU, Motherboard, BIOS, Storage, Serial Number -->
                                    <TextBlock x:Name="lblCpuDetails"
                                               Text="Processor: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblRamDetails"
                                               Text="RAM Memory: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblGpuDetails"
                                               Text="Graphics Card: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblMotherboard"
                                               Text="Motherboard: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblBiosInfo"
                                               Text="BIOS: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblDiskDetails"
                                               Text="Storage: Detecting..."
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Device Serial Number with Copy Button -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0" Height="22">
                                        <TextBlock x:Name="lblSerialTag"
                                                   Text="Serial Number: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblSerialNumber"
                                                   Text="Not available"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="btnCopySerial"
                                                Content="📋 Copy"
                                                Style="{StaticResource BtnDefault}"
                                                Height="22"
                                                FontSize="10"
                                                Padding="8,0"
                                                Click="BtnCopySerial_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right Block: Operating System (Vertically aligned with left card) -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch">
                                <Grid VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock x:Name="txtOsCardTitle"
                                                   Text="🪟 Operating System"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock x:Name="lblOsTitle"
                                                   Text="Detecting Windows..."
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,4"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="lblOsDetails"
                                                   Text="OS build and version..."
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,0,0,4"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Device Name positioned at same exact height as Serial Number -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0" Height="22">
                                        <TextBlock x:Name="lblMachineNameTag"
                                                   Text="Device Name: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblMachineName"
                                                   Text="Detecting..."
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom Block: Quick Common Tasks -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtCommonTasksTitle"
                                           Text="⚡ Common Tasks"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="4" Rows="2" HorizontalAlignment="Stretch">
                                    <Button x:Name="btnTaskPostInstall"
                                            Content="📦 App Manager"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Go to application and installer manager"
                                            Click="BtnTaskPostInstall_Click"/>
                                    <Button x:Name="btnTaskMaintenanceFolder"
                                            Content="📁 Maintenance Folder"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Open portable maintenance tools folder"
                                            Click="BtnOpenMaintenanceFolder_Click"/>
                                    <Button x:Name="btnTaskChrisTitus"
                                            Content="🚀 Chris Titus WinUtil"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Run Chris Titus Tech utility (PowerShell)"
                                            Click="BtnChrisTitus_Click"/>
                                    <Button x:Name="btnTaskMassgrave"
                                            Content="🔑 Massgrave (MAS)"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Run Microsoft MAS activator via PowerShell"
                                            Click="BtnMassgrave_Click"/>
                                    <Button x:Name="btnTaskMemoryDiag"
                                            Content="🧠 Memory Diagnostic"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Run Windows Memory Diagnostic (mdsched.exe)"
                                            Click="BtnMemoryDiag_Click"/>
                                    <Button x:Name="btnTaskDevMgmt"
                                            Content="🖥️ Device Manager"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Open Device Manager (devmgmt.msc)"
                                            Click="BtnDevMgmt_Click"/>
                                    <Button x:Name="btnTaskSysDm"
                                            Content="⚙️ System Properties"
                                            Style="{StaticResource BtnDefault}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Open System Properties (sysdm.cpl)"
                                            Click="BtnSysDm_Click"/>
                                    <Button x:Name="btnRebootBios"
                                            Content="⚡ Reboot to UEFI"
                                            Style="{StaticResource BtnDanger}"
                                            Height="34" Margin="3" FontSize="11"
                                            ToolTip="Restart computer directly into BIOS / UEFI"
                                            Click="BtnRebootBios_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 1: APP MANAGER (POST-INSTALL)               -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelPostInstall" Visibility="Collapsed" Margin="4">
                        <!-- Main Header -->
                        <StackPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock x:Name="txtPostInstallTitle"
                                       Text="App Manager"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtPostInstallSubtitle"
                                       Text="Automated installation of essential software and update of installed applications"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- SECTION 1: APPLICATION UPDATES (Always Visible) -->
                        <Border x:Name="cardWingetUpgrades"
                                Visibility="Visible"
                                Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtWingetCardTitle"
                                                   Text="🔄 Application Updates"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushAccent}" />
                                        <TextBlock x:Name="lblWingetUpgradeStatus"
                                                   Text="Click 'Check Updates' or wait for the winget query..."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="btnCheckWingetUpgrades"
                                             Grid.Column="1"
                                             Content="🔄 Check Updates"
                                             Style="{StaticResource BtnDefault}"
                                             Padding="10,3"
                                             Click="BtnCheckWingetUpgrades_Click" />
                                </Grid>

                                <!-- Progress Bar / Loading Indicator -->
                                <ProgressBar x:Name="pbWingetScan"
                                             IsIndeterminate="True"
                                             Height="6"
                                             Margin="0,0,0,6"
                                             Foreground="{DynamicResource BrushAccent}"
                                             Background="{DynamicResource BrushBgPrimary}"
                                             BorderThickness="0"
                                             Visibility="Collapsed" />

                                <!-- Centered View Logs Button during execution -->
                                <StackPanel x:Name="pnlWingetLogsAction"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8"
                                            Visibility="Collapsed">
                                    <Button x:Name="btnViewLogsFromUpgrade"
                                            Content="⬛ View Logs"
                                            Style="{StaticResource BtnDefault}"
                                            Height="28"
                                            Padding="14,0"
                                            ToolTip="Monitor execution log in real time on the Logs screen"
                                            Click="BtnViewLogs_Click" />
                                </StackPanel>

                                <!-- Upgradable Applications List -->
                                <Border x:Name="borderUpgradesList"
                                        Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        MaxHeight="220"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icWingetUpgradesList">
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <Border BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="0,0,0,1" Padding="4,5">
                                                         <Grid>
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto" />
                                                                 <ColumnDefinition Width="220" />
                                                                 <ColumnDefinition Width="200" />
                                                                 <ColumnDefinition Width="*" />
                                                             </Grid.ColumnDefinitions>
                                                             <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                             <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                             <TextBlock Grid.Column="2" Text="{Binding VersionDisplay}" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                             <TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                         </Grid>
                                                     </Border>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Upgrade Panel Action Buttons -->
                                <Grid x:Name="gridUpgradeActions" Visibility="Collapsed" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button x:Name="btnSelectAllUpgrades"
                                                Content="Select All"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnSelectAllUpgrades_Click"/>
                                        <Button x:Name="btnDeselectAllUpgrades"
                                                Content="Deselect All"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnDeselectAllUpgrades_Click"/>
                                        <Button x:Name="btnRecheckWingetUpgrades"
                                                Content="🔄 Check Again"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnRecheckWingetUpgrades_Click"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="btnUpgradeAll"
                                                Content="🚀 Update All"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnUpgradeAll_Click" />
                                        <Button x:Name="btnUpgradeSelected"
                                                Content="🔄 Update Selected"
                                                Style="{StaticResource BtnAccent}"
                                                Click="BtnUpgradeSelected_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Expandable Customization Panel (Config\autoinstall.json) -->
                        <Border x:Name="cardCustomizePostInstall"
                                Visibility="Collapsed"
                                Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushAccent}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="txtCustomizeHeaderTitle"
                                                   Text="⚙️ Customize Automated Application Installation"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource BrushAccent}" />
                                        <TextBlock x:Name="txtCustomizeHeaderSub"
                                                   Text="Add new programs, set whether they are automated by default, and choose between Local installer or Winget."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="btnCloseCustomize"
                                            Grid.Column="1"
                                            Content="✕ Close"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="8,2"
                                            Click="BtnCloseCustomize_Click" />
                                </Grid>

                                <!-- Program Add/Edit Form -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Program Name -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                            <TextBlock x:Name="txtNewAppNameLabel" Text="Program Name:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                                            <TextBox x:Name="txtNewAppName" Height="26" />
                                        </StackPanel>

                                        <!-- Installation Type -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                                            <TextBlock x:Name="txtNewAppTypeLabel" Text="Installation Type:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                                            <ComboBox x:Name="cmbNewAppType" Height="26" SelectedIndex="0" SelectionChanged="CmbNewAppType_SelectionChanged">
                                                <ComboBoxItem x:Name="cmbItemLocal" Content="📁 Local (PostInstall)" Tag="Local" />
                                                <ComboBoxItem x:Name="cmbItemWinget" Content="🌐 Winget (Repository)" Tag="Winget" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Local: Select File in PostInstall Folder -->
                                        <StackPanel x:Name="panelNewAppLocal" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" Visibility="Visible">
                                            <TextBlock x:Name="txtNewAppLocalLabel" Text="Executable in PostInstall folder:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtNewAppLocalFile" Height="26" Margin="0,0,4,0" ToolTip="Name of the executable in PostInstall folder (e.g. OfficeSetup.exe)" />
                                                <Button x:Name="btnSelectLocalInstaller"
                                                        Grid.Column="1"
                                                        Content="📁 Select..."
                                                        Style="{StaticResource BtnDefault}"
                                                        Height="26"
                                                        Padding="8,0"
                                                        ToolTip="Select executable file from PostInstall folder"
                                                        Click="BtnSelectLocalInstaller_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Winget: Enter App ID -->
                                        <StackPanel x:Name="panelNewAppWinget" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" Visibility="Collapsed">
                                            <TextBlock x:Name="txtNewAppWingetLabel" Text="Winget App ID (e.g. Google.Chrome):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                                            <TextBox x:Name="txtNewAppWingetId" Height="26" ToolTip="Package identifier in Winget repository" />
                                        </StackPanel>

                                        <!-- Add / Save and Cancel Buttons -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <Button x:Name="btnAddCustomApp"
                                                    Content="➕ Add"
                                                    Style="{StaticResource BtnAccent}"
                                                    Height="26"
                                                    Padding="12,0"
                                                    Margin="0,0,4,0"
                                                    Click="BtnAddCustomApp_Click" />
                                            <Button x:Name="btnCancelEditApp"
                                                    Content="✕"
                                                    Style="{StaticResource BtnDefault}"
                                                    Height="26"
                                                    Width="26"
                                                    Visibility="Collapsed"
                                                    ToolTip="Cancel edit"
                                                    Click="BtnCancelEditApp_Click" />
                                        </StackPanel>

                                        <!-- Row 2: Automate and Silent Arguments -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                            <CheckBox x:Name="chkNewAppPreSelected"
                                                      Content="Automate by default"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0" />
                                            <TextBlock x:Name="txtNewAppSilentLabel" Text="Silent arguments (optional):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="txtNewAppSilentArgs" Width="180" Height="24" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- autoinstall.json Programs List for Editing -->
                                <TextBlock x:Name="txtCurrentListTitle"
                                           Text="Programs in current list:"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Margin="0,0,0,4" />

                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        MaxHeight="190">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icCustomAppsEditorList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="0,0,0,1" Padding="4,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayTypeInfo}"
                                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <CheckBox Grid.Column="2"
                                                                      Content="{Binding AutomateLabel}"
                                                                      IsChecked="{Binding PreSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DetailInfo}"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="▲"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnMoveAppUp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding ToolTipMoveUp}" />
                                                                <Button Content="▼"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnMoveAppDown_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding ToolTipMoveDown}" />
                                                                <Button Content="✏"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,3,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnEditCustomApp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding ToolTipEdit}" />
                                                                <Button Content="🗑"
                                                                        Width="28" Height="24"
                                                                        Margin="0,0,0,0"
                                                                        Style="{StaticResource BtnRowAction}"
                                                                        Click="BtnRemoveCustomApp_Click"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding ToolTipRemove}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Editor Footer Actions -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button x:Name="btnSaveCustomApps"
                                                Content="💾 Save Changes"
                                                Style="{StaticResource BtnAccent}"
                                                Margin="0,0,6,0"
                                                Click="BtnSaveCustomApps_Click" />
                                        <Button x:Name="btnResetDefaultApps"
                                                Content="🔄 Restore Default List"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnResetDefaultApps_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="btnOpenPostInstallJson"
                                                Content="📂 Open autoinstall.json"
                                                Style="{StaticResource BtnDefault}"
                                                Click="BtnOpenPostInstallJson_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: AUTOMATED APPLICATION INSTALLATION LIST -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Installation Section Header -->
                                <TextBlock x:Name="txtAppsInstallCardTitle"
                                           Text="📦 Automated Application Installation"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtAppsInstallCardSub"
                                           Text="Select the programs you want to automatically batch-install on the computer:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"/>

                                <!-- ScrollViewer List -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="4"
                                        MaxHeight="260"
                                        Margin="0,0,0,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BrushBorderCard}" BorderThickness="0,0,0,1" Padding="6,7">
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Installation Progress Bar -->
                                <ProgressBar x:Name="pbInstallProgress"
                                             Height="6"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Stretch"
                                             Foreground="{DynamicResource BrushAccent}"
                                             Background="{DynamicResource BrushBgPrimary}"
                                             BorderThickness="0"/>

                                <!-- Action Buttons at Screen Bottom -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnSelectEssentials"
                                                Content="Select Essentials"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnSelectEssentials_Click"/>
                                        <Button x:Name="btnDeselectAll"
                                                Content="Deselect All"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnDeselectAll_Click"/>
                                        <Button x:Name="btnToggleCustomizePostInstall"
                                                Content="⚙️ Customize Automated Installation"
                                                Style="{StaticResource BtnDefault}"
                                                Margin="0,0,6,0"
                                                Click="BtnToggleCustomizePostInstall_Click"/>
                                        <Button x:Name="btnOpenPostInstallFolder"
                                                Content="📂 Installers Folder"
                                                Style="{StaticResource BtnDefault}"
                                                Click="BtnOpenPostInstallFolder_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnRunInstallSelected"
                                                Content="🚀 Install Selected"
                                                Style="{StaticResource BtnAccent}"
                                                Padding="16,0"
                                                Height="30"
                                                Click="BtnInstallSelected_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 2: OPTIMIZATION                             -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelOptimization" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtOptTitle"
                                       Text="System Optimization"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtOptSubtitle"
                                       Text="Advanced cleanup tools, Windows integrity, community scripts, and benchmark"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Community Tools Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtCommSectionTitle"
                                           Text="🚀 Community Tools"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="2" Margin="0,0,0,0">
                                    <Button x:Name="btnChrisTitusOpt"
                                            Content="🚀 Chris Titus Tool (WinUtil)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnChrisTitus_Click"/>
                                    <Button x:Name="btnMassgraveOpt"
                                            Content="🔑 Massgrave Activation (MAS)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnMassgrave_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 2-Column Grid for Tools (Integrity on Left, Cleanup & Performance on Right) -->
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: System Integrity & Repairs -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,4,8"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="txtIntegrityTitle"
                                               Text="🛡️ System Integrity &amp; Repairs"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnSfc"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnSfcRepair_Click"
                                            ToolTip="Check and Repair Windows Integrity via SFC (sfc /scannow)">
                                        <TextBlock x:Name="txtBtnSfcText"
                                                   Text="🛡️ Check and Repair Windows Integrity via SFC"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnDism"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnDismRepair_Click"
                                            ToolTip="Check and Repair Windows Integrity via DISM (Dism /Online /Cleanup-Image /RestoreHealth)">
                                        <TextBlock x:Name="txtBtnDismText"
                                                   Text="🔧 Check and Repair Windows Integrity via DISM"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnChkdsk"
                                            Content="🔍 Check Disk Integrity (CHKDSK C:)"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnChkdsk_Click"/>
                                    <Button x:Name="btnPrinterFix"
                                            Content="🖨️ Fix Network Printer Issue"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnFixPrinter_Click"/>
                                    <Button x:Name="btnDualBoot"
                                            Content="🕒 Fix System Time for Dual Boot"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnDualBootClock_Click"/>
                                    <Button x:Name="btnStoreFix"
                                            Content="🏪 Install or Repair Microsoft Store"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnWsReset_Click"/>
                                    <Button x:Name="btnNetReset"
                                            Content="🌐 Network Reset"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnResetNetwork_Click"/>
                                    <Button x:Name="btnWinSat"
                                            Content="📊 WinSAT Benchmark"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnWinSatBenchmark_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Column: Cleanup & Performance -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="4,0,0,8"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="txtCleanupTitle"
                                               Text="🧹 Cleanup &amp; Performance"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnTempClean"
                                            Content="🧹 Clean Temporary Files"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCleanTemp_Click"/>
                                    <Button x:Name="btnUpdateClean"
                                            Content="🧼 Clean Windows Update Cache"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCleanUpdate_Click"/>
                                    <Button x:Name="btnVisualEffects"
                                            Content="⚡ Optimize Visual Effects"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnVisualFX_Click"/>
                                    <Button x:Name="btnTelemetry"
                                            Content="🔇 Disable Telemetry and Optimize System Services"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnTelemetry_Click"/>
                                    <Button x:Name="btnCompactOs"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnCompactOs_Click"
                                            ToolTip="Compact Windows OS (compact.exe /CompactOS:always) - Reduces disk footprint">
                                        <TextBlock x:Name="txtBtnCompactOsText"
                                                   Text="🗜️ Compact Windows OS"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnOpenScriptsFolder"
                                            Content="📂 Open Scripts Folder"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnOpenScriptsFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 3: WINDOWS TOOLS                            -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelShortcuts" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtToolsTitle"
                                       Text="Windows Tools"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtToolsSubtitle"
                                       Text="Instant access to native Windows administrative tools and portable utilities"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Administrative Tools Grid -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtAdminToolsTitle"
                                           Text="🪟 Administrative Tools"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="3" Margin="0,0,0,0">
                                    <Button x:Name="btnDevMgmtTool" Content="🔌 Device Manager" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDevMgmt_Click"/>
                                    <Button x:Name="btnNetplwiz" Content="👤 User Accounts (Netplwiz)" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNetplwiz_Click"/>
                                    <Button x:Name="btnDiskMgmt" Content="💾 Disk Management" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDiskMgmt_Click"/>
                                    <Button x:Name="btnControl" Content="⚙️ Classic Control Panel" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnControlPanel_Click"/>
                                    <Button x:Name="btnMsinfo" Content="ℹ️ System Information (msinfo32)" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsInfo_Click"/>
                                    <Button x:Name="btnWinver" Content="📋 About Windows (winver)" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnWinver_Click"/>
                                    <Button x:Name="btnMsconfig" Content="🔧 MSCONFIG Tool" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsConfig_Click"/>
                                    <Button x:Name="btnSysDmTool" Content="💻 System Properties" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnSysDm_Click"/>
                                    <Button x:Name="btnNcpa" Content="🌐 Network Connections (ncpa.cpl)" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNcpa_Click"/>
                                    <Button x:Name="btnOptionalFeatures" Content="📦 Windows Features" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnOptionalFeatures_Click"/>
                                    <Button x:Name="btnRegedit" Content="🔑 Registry Editor (regedit)" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnRegedit_Click"/>
                                    <Button x:Name="btnTaskmgr" Content="📊 Task Manager" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnTaskMgr_Click"/>
                                    <Button x:Name="btnResmon" Content="⚡ Resource Monitor" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnResmon_Click"/>
                                    <Button x:Name="btnMemoryDiagTool" Content="🧠 Memory Diagnostic" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMemoryDiag_Click"/>
                                    <Button x:Name="btnRelMon" Content="📈 Reliability Monitor" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnReliability_Click"/>
                                    <Button x:Name="btnEventVwr" Content="📑 Event Viewer" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnEventVwr_Click"/>
                                    <Button x:Name="btnGpedit" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnGpedit_Click"
                                            ToolTip="Group Policy Editor (gpedit.msc) - Available in Windows Pro &amp; Enterprise editions">
                                        <TextBlock x:Name="txtBtnGpeditText"
                                                   Text="📜 GPEDIT Tool (Pro/Enterprise)"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Maintenance Tools Folder button positioned directly below Administrative Tools -->
                        <Button x:Name="btnOpenMaintenanceFolderTool"
                                Content="📂 Maintenance Tools Folder (Portable)"
                                Style="{StaticResource BtnDefault}"
                                Height="36"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnOpenMaintenanceFolder_Click"
                                ToolTip="Access local Maintenance folder containing portable tools"/>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 4: MAINTENANCE REPORT                      -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelReport" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtReportTitle"
                                       Text="Maintenance Report"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtReportSub"
                                       Text="Generates a report with machine specs, motherboard, serial number, and services"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Report Form -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Service and Device Details -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtReportOrderLabel" Text="Order No.:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportOrder" Height="26"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtReportClientLabel" Text="Client Name:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportClient" Height="26"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="txtReportSerialLabel" Text="Serial No. / Service Tag:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtReportSerial" Height="26"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Services Checklist (ALL UNCHECKED BY DEFAULT) -->
                                <TextBlock x:Name="txtChecklistLabel" Text="Services and Procedures Checklist:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox x:Name="chkActSmart" Content="Disk diagnostics and SMART health" IsChecked="False"/>
                                    <CheckBox x:Name="chkActClean" Content="Preventive internal cleaning and thermal paste" IsChecked="False"/>
                                    <CheckBox x:Name="chkActFormat" Content="Clean Windows installation" IsChecked="False"/>
                                    <CheckBox x:Name="chkActDrivers" Content="Full driver and BIOS update" IsChecked="False"/>
                                    <CheckBox x:Name="chkActApps" Content="Essential application setup" IsChecked="False"/>
                                    <CheckBox x:Name="chkActTemp" Content="Deep temporary files cleanup" IsChecked="False"/>
                                    <CheckBox x:Name="chkActDism" Content="System integrity repair (DISM / SFC)" IsChecked="False"/>
                                    <CheckBox x:Name="chkActNet" Content="Network and printer setup" IsChecked="False"/>
                                </UniformGrid>

                                <!-- Technical Assessment with Suggestive Placeholder -->
                                <TextBlock x:Name="txtReportNotesLabel" Text="Technical Assessment &amp; Observations:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtReportNotes"
                                         Height="50"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="Enter technical observations, hardware replaced, or recommendations..."
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         GotFocus="TxtReportNotes_GotFocus"
                                         LostFocus="TxtReportNotes_LostFocus"
                                         Margin="0,0,0,8"/>

                                <!-- Report Actions -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSaveReport"
                                            Content="📄 Generate Maintenance Report"
                                            Style="{StaticResource BtnAccent}"
                                            Margin="0,0,8,0"
                                            Click="BtnSaveReport_Click"/>
                                    <Button x:Name="btnCopyReport"
                                            Content="📋 Copy Technical Report"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="0,0,8,0"
                                            Click="BtnCopyReport_Click"/>
                                    <Button x:Name="btnOpenReportFolder"
                                            Content="📂 Open Reports Folder"
                                            Style="{StaticResource BtnDefault}"
                                            Click="BtnOpenReportFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- ================================================ -->
                    <!-- TAB 5: SETTINGS                                -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelSettings" Visibility="Collapsed" Margin="4">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="txtSettingsTitle"
                                       Text="OptiAssist Settings"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtSettingsSub"
                                       Text="Settings saved in Config\settings.json on the portable drive"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Service Provider Mode -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="chkServiceProviderMode"
                                                  Content="Service provider mode"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Checked="ChkServiceProviderMode_Changed"
                                                  Unchecked="ChkServiceProviderMode_Changed"/>
                                        <TextBlock x:Name="txtServiceProviderDesc"
                                                   Text="Enables branding customization and options for service orders and technical reports"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="24,2,0,0"/>

                                        <!-- Section with Custom App Name, Contact Info and Enable Maintenance Report -->
                                        <StackPanel x:Name="pnlServiceProviderFields" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="txtStoreNameLabel" Text="Custom application name:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtSettingStore" Height="26" TextChanged="TxtSettingStore_TextChanged" ToolTip="Customize the application according to the name you prefer."/>
                                            <TextBlock x:Name="txtStoreNameHint" Text="💡 Customize the application according to the name you prefer." FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,8"/>

                                            <TextBlock x:Name="txtPhoneLabel" Text="Contact Information:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="txtSettingPhone" Height="26" ToolTip="Provide an email, phone number, or social media link of your choice"/>
                                            <TextBlock x:Name="txtPhoneHint" Text="💡 Provide an email, phone number, or social media link of your choice" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,8"/>

                                            <CheckBox x:Name="chkEnableMaintenanceReport"
                                                      Content="Enable Maintenance Report"
                                                      FontWeight="SemiBold"
                                                      Margin="0,4,0,2"
                                                      Checked="ChkEnableMaintenanceReport_Changed"
                                                      Unchecked="ChkEnableMaintenanceReport_Changed"/>
                                            <TextBlock x:Name="txtEnableReportDesc"
                                                       Text="Shows or hides the Maintenance Report screen in the sidebar menu"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="24,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="txtReportPathLabel" Text="Default Report File Path:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtSettingReportPath" Height="26" Margin="0,0,0,8"/>

                                <!-- Language Selection Buttons -->
                                <TextBlock x:Name="txtLangLabel" Text="Application Language:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <StackPanel x:Name="pnlLanguageButtons" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="btnLangPt"
                                            Content="🇧🇷 Português (Brasil)"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,4"
                                            Margin="0,0,8,0"
                                            Click="BtnLangPt_Click"/>
                                    <Button x:Name="btnLangEn"
                                            Content="🇺🇸 English (US)"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,4"
                                            Margin="0,0,8,0"
                                            Click="BtnLangEn_Click"/>
                                    <TextBlock x:Name="lblCurrentLanguage"
                                               Text="Current: English (en-US)"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="chkSettingWinget"
                                          Checked="ChkSettingWinget_Changed"
                                          Unchecked="ChkSettingWinget_Changed"
                                          Content="Enable Winget download fallback when program is not in PostInstall folder"
                                          Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkSettingAutoRefresh"
                                          Checked="ChkSettingAutoRefresh_Changed"
                                          Unchecked="ChkSettingAutoRefresh_Changed"
                                          Content="Automatically refresh hardware specs on startup"
                                          Margin="0,2,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnSaveSettings"
                                            Content="💾 Save Settings"
                                            Style="{StaticResource BtnAccent}"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,0"
                                            Click="BtnSaveSettings_Click"/>
                                    <Button x:Name="btnResetSettings"
                                            Content="🔄 Restore Defaults"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnResetSettings_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Application Customization (Colors and Accents) -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtPersonalizeTitle"
                                           Text="🎨 Customize Application"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtPersonalizeSub"
                                           Text="Customize the visual theme, button accent colors, and styling of OptiAssist:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Light Mode / Dark Mode Toggle -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="txtThemeLabel" Text="Visual Theme:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <Button x:Name="btnToggleTheme"
                                            Style="{StaticResource BtnDefault}"
                                            Height="30"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="Toggle between dark mode and light mode"
                                            Click="BtnToggleTheme_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtThemeIcon" Text="☀️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtThemeText" Text="Light Mode" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Row: Hex Code + Color Picker + Apply Button + Preview -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hexadecimal Input Field -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtAccentLabel" Text="Accent &amp; Button Color (Hexadecimal):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtSettingAccentColor" Text="#0EA5E9" Height="28" TextChanged="TxtSettingAccentColor_TextChanged"/>
                                    </StackPanel>

                                    <!-- Color Picker Dialog Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,8,0">
                                        <Button x:Name="btnOpenColorDialog"
                                                Content="🎨 Pick Color..."
                                                Style="{StaticResource BtnDefault}"
                                                Height="28"
                                                Padding="10,0"
                                                ToolTip="Open Windows color picker dialog"
                                                Click="BtnOpenColorDialog_Click"/>
                                    </StackPanel>

                                    <!-- Apply Color Button -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <Button x:Name="btnApplyCustomColor"
                                                Content="✔️ Apply Color"
                                                Style="{StaticResource BtnAccent}"
                                                Height="28"
                                                Padding="12,0"
                                                ToolTip="Apply the specified accent color immediately to OptiAssist"
                                                Click="BtnApplyCustomColor_Click"/>
                                    </StackPanel>

                                    <!-- Preview Box -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtPreviewLabel"
                                                   Text="Preview: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <Border x:Name="borderPreviewColor"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushAccent}"
                                                BorderBrush="{DynamicResource BrushBorderCard}"
                                                BorderThickness="1"
                                                ToolTip="Current accent color"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Preset Color Palette -->
                                <TextBlock x:Name="txtPresetLabel" Text="Suggested Colors:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="btnPresetBlue" Content="🔵 Blue (Default)" Tag="#0EA5E9" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetGreen" Content="🟢 Light Green" Tag="#10B981" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPurple" Content="🟣 Purple" Tag="#8B5CF6" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetOrange" Content="🟠 Orange" Tag="#F97316" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetRed" Content="🔴 Red" Tag="#FF4444" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetYellow" Content="🟡 Yellow" Tag="#F59E0B" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPink" Content="🌸 Pink" Tag="#FC4899" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 6: ABOUT THE APPLICATION                    -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelAbout" Visibility="Collapsed" Margin="4">
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,12" VerticalAlignment="Center">
                            <TextBlock x:Name="txtAboutTitle"
                                       Text="ℹ️ About OptiAssist"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtAboutSub"
                                       Text="Version information, open-source license terms, and official channels"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Main License and Information Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="OptiAssist v1.0.0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Copyright (C) 2026 João Figueiró"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           Margin="0,0,0,10"/>

                                <!-- GNU GPLv3 Explicit License Badge -->
                                <Border Background="{DynamicResource BrushBgInput}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock x:Name="txtAboutLicenseTag"
                                               Text="⚖️ License: GNU General Public License v3.0 (GNU GPLv3)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushAccent}"/>
                                </Border>

                                <!-- Acknowledgments & Credits to Chris Titus -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="txtAboutCreditsTitle"
                                                   Text="🤝 Acknowledgments &amp; Credits"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="txtAboutCreditsText"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   LineHeight="16"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Text="Special thanks and credit to Chris Titus Tech and the open-source community behind WinUtil, whose work served as an essential inspiration and foundation for the implementation of several system maintenance and optimization features in OptiAssist."/>
                                    </StackPanel>
                                </Border>

                                <!-- GPLv3 Notice Box -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,14">
                                    <TextBlock TextWrapping="Wrap"
                                               FontFamily="Consolas, Lucida Console, Segoe UI"
                                               FontSize="11"
                                               LineHeight="17"
                                               Foreground="{DynamicResource BrushTextSecondary}">
This program is free software: you can redistribute it and/or modify 
it under the terms of the GNU General Public License as published by 
the Free Software Foundation, either version 3 of the License, or 
(at your option) any later version.

This program is distributed in the hope that it will be useful, 
but WITHOUT ANY WARRANTY; without even the implied warranty of 
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the 
GNU General Public License for more details.

You should have received a copy of the GNU General Public License 
along with this program. If not, see &lt;https://www.gnu.org/licenses/&gt;.
                                    </TextBlock>
                                </Border>

                                <!-- Official Links / Buttons -->
                                <WrapPanel>
                                    <Button x:Name="btnAboutGithub"
                                            Content="🐙 GitHub Repository"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutGithub_Click"/>
                                    <Button x:Name="btnAboutWebsite"
                                            Content="🌐 Official Website"
                                            Style="{StaticResource BtnAccent}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutWebsite_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

                <!-- ======================================================== -->
                <!-- DEDICATED TAB: OUTPUT TERMINAL & COMMAND EXECUTION       -->
                <!-- ======================================================== -->
                <Grid x:Name="panelTerminal"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top: Header with Title and Actions -->
                        <RowDefinition Height="*" />    <!-- Center: Monospace Console -->
                    </Grid.RowDefinitions>

                    <!-- Top: Title & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLogsTitle"
                                       Text="⬛ Logs"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtLogsSub"
                                       Text="Real-time log of diagnostics, scripts, and system executions"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnExportLog"
                                    Content="💾 Export Log"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnSaveLog_Click"/>
                            <Button x:Name="btnCopyAllLog"
                                    Content="📋 Copy All"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnCopyLog_Click"/>
                            <Button x:Name="btnClearLog"
                                    Content="🗑️ Clear Console"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Center: Monospace Console / Terminal Window -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushConsoleBg}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox x:Name="txtConsoleLog"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Lucida Console, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushConsoleText}"
                                 BorderThickness="0"
                                 Padding="12,10"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: BOTTOM STATUS BAR                                 -->
        <!-- BitLocker | TPM | Secure Boot                            -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
            Background="{DynamicResource BrushBgSidebar}"
            BorderBrush="{DynamicResource BrushBorderCard}"
            BorderThickness="0,1,0,0"
            Padding="14,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. BitLocker (Clickable) -->
                <StackPanel x:Name="pnlBitLockerStatus"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Click to open BitLocker / Device Encryption settings"
                            MouseLeftButtonDown="PnlBitLockerStatus_MouseLeftButtonDown">
                    <TextBlock x:Name="txtBitLockerLabel"
                               Text="🔒 BitLocker: "
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBitLockerStatus"
                               Text="Querying..."
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushWarning}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 2. TPM (Clickable) -->
                <StackPanel x:Name="pnlTpmStatus"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Click to open TPM Management console (tpm.msc)"
                            MouseLeftButtonDown="PnlTpmStatus_MouseLeftButtonDown">
                    <TextBlock x:Name="txtTpmLabel"
                               Text="🛡️ TPM: "
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTpmStatus"
                               Text="Querying..."
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushWarning}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 3. Secure Boot -->
                <TextBlock x:Name="txtSecureBootLabel"
                           Text="⚡ Secure Boot: "
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSecureBootStatus"
                           Text="Querying..."
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right Side: Persistent OptiAssist Brand -->
            <TextBlock x:Name="lblFooterStoreName"
                       Grid.Column="1"
                       Text="OptiAssist"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Grid>
</Window>
