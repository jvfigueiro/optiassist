but WITHOUT ANY WARRANTY; without even the implied warranty of 
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the 
GNU General Public License for more details.

You should have received a copy of the GNU General Public License 
along with this program. If not, see &lt;https://www.gnu.org/licenses/&gt;.
                                    </TextBlock>
                                </Border>

                                <!-- Official Links / Buttons -->
                                <WrapPanel>
                                    <Button x:Name="btnAboutGithub"
                                            Content="🐙 GitHub Repository"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutGithub_Click"/>
                                    <Button x:Name="btnAboutWebsite"
                                            Content="🌐 Official Website"
                                            Style="{StaticResource BtnAccent}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutWebsite_Click"/>
                                    <Button x:Name="btnAboutDocumentation"
                                            Content="📖 Documentation"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutDocumentation_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- About Installed Modules & Plugins Summary Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtAboutAddonsTitle"
                                           Text="🧩 About Installed Modules &amp; Plugins"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtAboutAddonsSubtitle"
                                           Text="Quick summary and AssemblyInfo metadata of all modular add-ons integrated into OptiAssist:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <ItemsControl x:Name="icAboutAddonsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgPrimary}"
                                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Icon}"
                                                               FontSize="22"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Summary + AssemblyInfo Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • v" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding AssemblyProduct}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyDescription}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                            <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyCompany}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding AssemblyCopyright}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="  •  " FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding DisplayPath}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource BrushBgCard}"
                                                            BorderBrush="{DynamicResource BrushBorderCard}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushAccent}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

                <!-- ======================================================== -->
                <!-- DEDICATED TAB: OUTPUT TERMINAL & COMMAND EXECUTION       -->
                <!-- ======================================================== -->
                <Grid x:Name="panelTerminal"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top: Header with Title and Actions -->
                        <RowDefinition Height="*" />    <!-- Center: Monospace Console -->
                    </Grid.RowDefinitions>

                    <!-- Top: Title & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLogsTitle"
                                       Text="⬛ Logs"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtLogsSub"
                                       Text="Real-time log of diagnostics, scripts, and system executions"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPopoutLog"
                                    Content="🗗 Pop-out Logs"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    ToolTip="Open Logs in a separate floating window"
                                    Click="BtnPopoutLog_Click"/>
                            <Button x:Name="btnExportLog"
                                    Content="💾 Export Log"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnSaveLog_Click"/>
                            <Button x:Name="btnCopyAllLog"
                                    Content="📋 Copy All"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnCopyLog_Click"/>
                            <Button x:Name="btnClearLog"
                                    Content="🗑️ Clear Console"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Center: Monospace Console / Terminal Window -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushConsoleBg}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox x:Name="txtConsoleLog"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Lucida Console, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushConsoleText}"
                                 BorderThickness="0"
                                 Padding="12,10"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: BOTTOM STATUS BAR                                 -->
        <!-- BitLocker | TPM | Secure Boot                            -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
            Background="{DynamicResource BrushBgSidebar}"
            BorderBrush="{DynamicResource BrushBorderCard}"
            BorderThickness="0,1,0,0"
            Padding="14,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. BitLocker (Clickable) -->
                <StackPanel x:Name="pnlBitLockerStatus"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Click to open BitLocker / Device Encryption settings"
                            MouseLeftButtonDown="PnlBitLockerStatus_MouseLeftButtonDown">
                    <TextBlock x:Name="txtBitLockerLabel"
                               Text="🔒 BitLocker: "
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtBitLockerStatus"
                               Text="Querying..."
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushWarning}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 2. TPM (Clickable) -->
                <StackPanel x:Name="pnlTpmStatus"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Click to open TPM Management console (tpm.msc)"
                            MouseLeftButtonDown="PnlTpmStatus_MouseLeftButtonDown">
                    <TextBlock x:Name="txtTpmLabel"
                               Text="🛡️ TPM: "
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTpmStatus"
                               Text="Querying..."
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushWarning}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderCard}" Margin="10,0" VerticalAlignment="Center"/>

                <!-- 3. Secure Boot -->
                <TextBlock x:Name="txtSecureBootLabel"
                           Text="⚡ Secure Boot: "
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSecureBootStatus"
                           Text="Querying..."
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right Side: Persistent OptiAssist Brand -->
            <TextBlock x:Name="lblFooterStoreName"
                       Grid.Column="1"
                       Text="OptiAssist"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Grid>
</Window>
