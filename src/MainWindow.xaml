<Window x:Class="OptiAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiAssist"
        Icon="app.ico"
        Width="1020" Height="640"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBgSidebar}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BtnWindowControl" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Symbol, Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnWindowClose" TargetType="Button" BasedOn="{StaticResource BtnWindowControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER DISCRETE WINDOW BORDER -->
    <Border x:Name="windowOuterBorder"
            Background="{DynamicResource BrushBgSidebar}"
            BorderBrush="{DynamicResource BrushBorderCard}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">

    <!-- MAIN GRID (Row 0: Top Header Bar, Row 1: Workspace, Row 2: Bottom Status Bar) -->
    <Grid Background="{DynamicResource BrushBgSidebar}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52" /> <!-- Row 0: Top Header Bar -->
            <RowDefinition Height="*" />                   <!-- Row 1: Workspace (Sidebar + Content Area) -->
            <RowDefinition Height="38" />                  <!-- Row 2: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP HEADER BAR (Custom Integrated Chrome)         -->
        <!-- Left: OptiAssist Branding | Right: Hardware + Win Btns   -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushBgSidebar}"
                Padding="14,6,10,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Left: Logo & Branding -->
                    <ColumnDefinition Width="*" />    <!-- Flexible middle spacing (Draggable Caption) -->
                    <ColumnDefinition Width="Auto" /> <!-- Right: Quick Hardware Specifications -->
                    <ColumnDefinition Width="Auto" /> <!-- Far Right: Integrated Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- Top Left: Application Branding (Logo + Title + Version Pill) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnToggleSidebar"
                            Content="☰"
                            Style="{StaticResource BtnDefault}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="30"
                            Height="30"
                            Padding="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Toggle Sidebar"
                            Click="BtnToggleSidebar_Click"/>
                    <Image x:Name="imgAppHeaderLogo"
                           Source="app.png"
                           Width="24"
                           Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblAppTitle"
                               Text="OptiAssist"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Top Right: Preserved Hardware Specifications (Visible on All Screens) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- Line 1: Motherboard (Manufacturer and Model) -->
                    <TextBlock x:Name="lblHeaderDevice"
                               Text="Detecting..."
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               HorizontalAlignment="Right"
                               ToolTip="Motherboard Model"/>

                    <!-- Line 2: Processor and RAM -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock x:Name="lblHeaderCpu"
                                   Text="Processor: ..."
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="310"
                                   ToolTip="Processor"/>
                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="6,0"/>
                        <TextBlock x:Name="lblHeaderRam"
                                   Text="RAM: ..."
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160"
                                   ToolTip="Total RAM Memory"/>
                    </StackPanel>
                </StackPanel>

                <!-- Far Right: Integrated Window Control Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnMinimizeWindow"
                            Content="─"
                            Style="{StaticResource BtnWindowControl}"
                            ToolTip="Minimize"
                            Click="BtnMinimizeWindow_Click"/>
                    <Button x:Name="btnMaximizeWindow"
                            Content="□"
                            Style="{StaticResource BtnWindowControl}"
                            Margin="2,0"
                            ToolTip="Maximize / Restore"
                            Click="BtnMaximizeWindow_Click"/>
                    <Button x:Name="btnCloseWindow"
                            Content="✕"
                            Style="{StaticResource BtnWindowClose}"
                            ToolTip="Close"
                            Click="BtnCloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: WORKSPACE (Sidebar + Content Area) -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colSidebar" Width="210" /> <!-- Column 0: Fixed Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Column 1: Dynamic Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (Width="210")            -->
            <!-- ========================================== -->
            <Border x:Name="borderSidebar"
                    Grid.Column="0"
                    Background="{DynamicResource BrushBgSidebar}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Navigation Buttons -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Top" Margin="0,6,0,8">
                            <RadioButton x:Name="rbNavDashboard"
                                         GroupName="SidebarNavGroup"
                                         Content="💻  Dashboard"
                                         Style="{StaticResource BtnNav}"
                                         IsChecked="True"
                                         Click="NavButton_Click"/>
                            <RadioButton x:Name="rbNavShortcuts"
                                         GroupName="SidebarNavGroup"
                                         Content="🛠️  Windows Tools"
                                         Style="{StaticResource BtnNav}"
                                         Click="NavButton_Click"/>
                            <RadioButton x:Name="rbNavTerminal"
                                         GroupName="SidebarNavGroup"
                                         Content="📜  Logs"
                                         Style="{StaticResource BtnNav}"
                                         Click="NavButton_Click"/>

                            <!-- Separator -->
                            <Border Height="1"
                                    Background="{DynamicResource BrushBorderCard}"
                                    Opacity="0.6"
                                    Margin="16,8"/>

                            <!-- Dynamic Add-on Modules Container -->
                            <StackPanel x:Name="pnlSidebarAddons" />

                            <!-- Separator -->
                            <Border Height="1"
                                    Background="{DynamicResource BrushBorderCard}"
                                    Opacity="0.6"
                                    Margin="16,8"/>

                            <RadioButton x:Name="rbNavSettings"
                                         GroupName="SidebarNavGroup"
                                         Content="⚙️  Settings"
                                         Style="{StaticResource BtnNav}"
                                         Click="NavButton_Click"/>
                            <RadioButton x:Name="rbNavAbout"
                                         GroupName="SidebarNavGroup"
                                         Content="ℹ️  About"
                                         Style="{StaticResource BtnNav}"
                                         Click="NavButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Subtle Sidebar Footer (Version Pill + Custom App Name fallback) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,10">
                        <TextBlock x:Name="lblFooterStoreName"
                                   Text="OptiAssist"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="1.2.S4"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- COLUMN 1: INSET ROUNDED CONTENT WORKSPACE  -->
            <!-- ========================================== -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BrushBgPrimary}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,2,10,4"
                    ClipToBounds="True">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- ======================================================== -->
                <!-- MAIN CONTENT (Central ScrollViewer for tabs)            -->
                <!-- ======================================================== -->
                <ScrollViewer x:Name="scrollViewerContent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="16,12,16,12">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- ================================================ -->
                    <!-- TAB 0: OVERVIEW (DASHBOARD - SPARKLE BENTO GRID) -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelDashboard" Visibility="Visible" Margin="4">
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtDashboardTitle"
                                           Text="Welcome to OptiAssist!"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtDashboardSubtitle"
                                           Text="The ultimate tool to keep your system in shape"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnDashboardInstallPc"
                                        Content="📥 Install on PC"
                                        Style="{StaticResource BtnAccent}"
                                        Height="34"
                                        Padding="12,0"
                                        FontSize="11"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Install OptiAssist on this computer with Desktop and Start Menu shortcuts"
                                        Visibility="Collapsed"
                                        Click="BtnDashboardInstallPc_Click"/>
                                <Button x:Name="btnDashboardThemeToggle"
                                        Style="{StaticResource BtnDefault}"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTip="Toggle Dark / Light Mode"
                                        Click="BtnToggleTheme_Click">
                                    <TextBlock x:Name="txtDashboardThemeIcon"
                                               Text="🌙"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 2x2 Sparkle-inspired Bento Grid -->
                        <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Card 1 (Row 0, Col 0): Hardware Info -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,6,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#1E3A8A" Margin="0,0,10,0">
                                                <TextBlock Text="🧠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="txtHwCardTitle" Text="Hardware Info" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="txtHwCardSubtitle" Text="Processor, Board, RAM &amp; GPU" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="lblCpuDetails"
                                                   Text="Processor: Detecting..."
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,3"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="lblMotherboard"
                                                   Text="Motherboard: Detecting..."
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,3"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="lblBiosInfo"
                                                   Text="BIOS: Detecting..."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,0,0,3"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="lblRamDetails"
                                                   Text="RAM Memory: Detecting..."
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,3"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="lblGpuDetails"
                                                   Text="Graphics Card: Detecting..."
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="22">
                                        <TextBlock x:Name="lblSerialTag"
                                                   Text="Serial: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblSerialNumber"
                                                   Text="Not available"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="btnCopySerial"
                                                Content="📋 Copy"
                                                Style="{StaticResource BtnDefault}"
                                                Height="22"
                                                FontSize="10"
                                                Padding="8,0"
                                                Click="BtnCopySerial_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2 (Row 0, Col 1): Operating System -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="6,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#991B1B" Margin="0,0,10,0">
                                                <TextBlock Text="🪟" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="txtOsCardTitle" Text="Operating System" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock x:Name="txtOsCardSubtitle" Text="OS Information" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="lblOsTitle"
                                                   Text="Detecting Windows..."
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,4"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="lblOsDetails"
                                                   Text="OS build and version..."
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,0,0,3"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="lblOsInstallDate"
                                                   Text="Install Date: Detecting..."
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,0,0,3"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="lblOsActivation"
                                                   Text="Activation: Detecting..."
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="22">
                                        <TextBlock x:Name="lblMachineNameTag"
                                                   Text="Device Name: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblMachineName"
                                                   Text="Detecting..."
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3 (Row 1, Col 0): Storage -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#92400E" Margin="0,0,10,0">
                                            <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtStorageCardTitle" Text="Storage" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="txtStorageCardSubtitle" Text="Disk Information" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="lblDiskDetails"
                                               Text="Storage: Detecting..."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel x:Name="pnlOtherDisks" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4 (Row 1, Col 1): Recommendations -->
                            <Border x:Name="borderRecommendations"
                                    Grid.Row="1" Grid.Column="1"
                                    Background="{DynamicResource BrushBgCard}"
                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="6,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#065F46" Margin="0,0,10,0">
                                            <TextBlock Text="💡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtRecommendationsTitle" Text="Recommendations" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="txtRecommendationsSubtitle" Text="System &amp; Hardware Advice" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
                                        <StackPanel x:Name="pnlRecommendationsList" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Common Tasks (Directly below Bento Grid) -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtCommonTasksTitle"
                                               Grid.Column="0"
                                               Text="⚡ Common Tasks"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushAccent}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="btnCustomizeCommonTasks"
                                            Grid.Column="1"
                                            Content="⚙️ Customize"
                                            Style="{StaticResource BtnDefault}"
                                            Height="24"
                                            Padding="10,0"
                                            FontSize="10.5"
                                            ToolTip="Customize shortcuts, add new tools, reorganize or remove tasks"
                                            Click="BtnCustomizeCommonTasks_Click"/>
                                </Grid>
                                <TextBlock x:Name="txtCommonTasksEmpty"
                                           Text="No common tasks configured. Click 'Customize' to add or restore default tasks."
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="2,2,0,6"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <UniformGrid x:Name="ugCommonTasks" Columns="3" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 3: WINDOWS TOOLS                            -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelShortcuts" Visibility="Collapsed" Margin="4">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtToolsTitle"
                                           Text="🛠️  Windows Tools"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtToolsSubtitle"
                                           Text="Instant access to native Windows administrative tools and portable utilities"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Administrative Tools Grid -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtAdminToolsTitle"
                                           Text="🪟 Administrative Tools"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis"/>
                                <UniformGrid Columns="3" Margin="0,0,0,0">
                                    <Button x:Name="btnDevMgmtTool" Content="Device Manager" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDevMgmt_Click"/>
                                    <Button x:Name="btnNetplwiz" Content="User Accounts" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNetplwiz_Click"/>
                                    <Button x:Name="btnDiskMgmt" Content="Disk Management" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnDiskMgmt_Click"/>
                                    <Button x:Name="btnControl" Content="Classic Control Panel" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnControlPanel_Click"/>
                                    <Button x:Name="btnMsinfo" Content="System Information" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsInfo_Click"/>
                                    <Button x:Name="btnWinver" Content="About Windows" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnWinver_Click"/>
                                    <Button x:Name="btnMsconfig" Content="MSCONFIG Tool" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMsConfig_Click"/>
                                    <Button x:Name="btnSysDmTool" Content="System Properties" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnSysDm_Click"/>
                                    <Button x:Name="btnNcpa" Content="Network Connections" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnNcpa_Click"/>
                                    <Button x:Name="btnOptionalFeatures" Content="Windows Features" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnOptionalFeatures_Click"/>
                                    <Button x:Name="btnRegedit" Content="Registry Editor" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnRegedit_Click"/>
                                    <Button x:Name="btnTaskmgr" Content="Task Manager" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnTaskMgr_Click"/>
                                    <Button x:Name="btnResmon" Content="Resource Monitor" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnResmon_Click"/>
                                    <Button x:Name="btnMemoryDiagTool" Content="Memory Diagnostic" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnMemoryDiag_Click"/>
                                    <Button x:Name="btnRelMon" Content="Reliability Monitor" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnReliability_Click"/>
                                    <Button x:Name="btnEventVwr" Content="Event Viewer" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnEventVwr_Click"/>
                                    <Button x:Name="btnGpedit" Style="{StaticResource BtnDefault}" Margin="3" Click="BtnGpedit_Click"
                                            ToolTip="Group Policy Editor (gpedit.msc) - Available in Windows Pro &amp; Enterprise editions">
                                        <TextBlock x:Name="txtBtnGpeditText"
                                                   Text="GPEDIT Tool (Pro/Ent)"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button x:Name="btnServicesTool"
                                            Content="Windows Services"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnServices_Click"
                                            ToolTip="Windows Services console (services.msc)"/>
                                    <Button x:Name="btnDateTimeTool"
                                            Content="Date &amp; Time"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnDateTime_Click"
                                            ToolTip="Windows Date &amp; Time administrative settings (timedate.cpl)"/>
                                    <Button x:Name="btnCleanmgrTool"
                                            Content="Disk Cleanup"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnCleanmgr_Click"
                                            ToolTip="Windows Disk Cleanup utility (cleanmgr.exe)"/>
                                    <Button x:Name="btnDfrguiTool"
                                            Content="Drive Optimizer"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnDfrgui_Click"
                                            ToolTip="Windows Drive Optimizer and Defragmenter (dfrgui.exe)"/>
                                    <Button x:Name="btnFirewallTool"
                                            Content="Windows Firewall"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnFirewall_Click"
                                            ToolTip="Windows Defender Firewall with Advanced Security (wf.msc)"/>
                                    <Button x:Name="btnOskTool"
                                            Content="On-Screen Keyboard"
                                            Style="{StaticResource BtnDefault}"
                                            Margin="3"
                                            Click="BtnOsk_Click"
                                            ToolTip="Windows On-Screen Keyboard utility (osk.exe)"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Maintenance Tools Folder button positioned directly below Administrative Tools -->
                        <Button x:Name="btnOpenMaintenanceFolderTool"
                                Content="📁 Maintenance Tools"
                                Style="{StaticResource BtnDefault}"
                                Height="36"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                Click="BtnOpenMaintenanceFolder_Click"
                                ToolTip="Access local Maintenance folder containing portable tools"/>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- DYNAMIC ADD-ON MODULE VIEW HOST                  -->
                    <!-- ================================================ -->
                    <Grid x:Name="panelAddonHost" Visibility="Collapsed" Margin="4" />

                    <!-- ================================================ -->
                    <!-- TAB 5: SETTINGS                                -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelSettings" Visibility="Collapsed" Margin="4">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtSettingsTitle"
                                           Text="⚙️  Settings"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtSettingsSub"
                                           Text="Configure general preferences, language, visual theme, system installation, and modular add-ons"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Language Selection ComboBox -->
                                <TextBlock x:Name="txtLangLabel" Text="Application Language:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox x:Name="cmbSettingsLanguage"
                                              Width="240"
                                              Height="32"
                                              FontSize="11.5"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="CmbSettingsLanguage_SelectionChanged"/>
                                    <TextBlock x:Name="lblCurrentLanguageAuthor"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="chkSettingWinget"
                                          Checked="ChkSettingWinget_Changed"
                                          Unchecked="ChkSettingWinget_Changed"
                                          Content="Enable Winget download fallback when program is not in Installers folder"
                                          Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkSettingAutoRefresh"
                                          Checked="ChkSettingAutoRefresh_Changed"
                                          Unchecked="ChkSettingAutoRefresh_Changed"
                                          Content="Automatically refresh hardware specs on startup"
                                          Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkSettingExternalLogs"
                                          Checked="ChkSettingExternalLogs_Changed"
                                          Unchecked="ChkSettingExternalLogs_Changed"
                                          Content="Open external Logs window by default"
                                          Margin="0,2,0,4"/>
                                <CheckBox x:Name="chkSettingAlwaysOnTop"
                                          Checked="ChkSettingAlwaysOnTop_Changed"
                                          Unchecked="ChkSettingAlwaysOnTop_Changed"
                                          Content="Keep OptiAssist main window always on top (Always on top)"
                                          Margin="0,2,0,12"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="btnSaveSettings"
                                            Content="💾 Save Settings"
                                            Style="{StaticResource BtnAccent}"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,4"
                                            Click="BtnSaveSettings_Click"/>
                                    <Button x:Name="btnResetSettings"
                                            Content="🔄 Restore Defaults"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,4"
                                            Click="BtnResetSettings_Click"/>
                                    <Button x:Name="btnInstallApp"
                                            Content="📥 Install OptiAssist"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,4"
                                            ToolTip="Open installation &amp; portable deployment options for OptiAssist"
                                            Click="BtnInstallApp_Click"/>
                                    <Button x:Name="btnUninstallApp"
                                            Content="🗑️ Uninstall OptiAssist"
                                            Style="{StaticResource BtnDefault}"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,4"
                                            Visibility="Collapsed"
                                            ToolTip="Uninstall OptiAssist from this device and remove all shortcuts"
                                            Click="BtnUninstallApp_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Application Customization (Colors and Accents) -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtPersonalizeTitle"
                                           Text="🎨 Customize Application"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtPersonalizeSub"
                                           Text="Customize the visual theme, button accent colors, branding, and styling of OptiAssist:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Custom Application Name -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="txtStoreNameLabel" Text="Custom application name:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="txtSettingStore" Height="26" TextChanged="TxtSettingStore_TextChanged" ToolTip="Customize the application according to the name you prefer."/>
                                    <TextBlock x:Name="txtStoreNameHint" Text="💡 Customize the application according to the name you prefer." FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Change App Logo Button -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="btnChangeAppLogo"
                                            Content="🖼️ Change App Logo"
                                            Style="{StaticResource BtnDefault}"
                                            Height="30"
                                            Padding="14,0"
                                            Margin="0,0,8,0"
                                            ToolTip="Select a custom logo image (.png, .jpg, .ico) for the application"
                                            Click="BtnChangeAppLogo_Click"/>
                                </StackPanel>

                                <!-- Light Mode / Dark Mode Toggle -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="txtThemeLabel" Text="Visual Theme:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <Button x:Name="btnToggleTheme"
                                            Style="{StaticResource BtnDefault}"
                                            Height="30"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="Toggle between dark mode and light mode"
                                            Click="BtnToggleTheme_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtThemeIcon" Text="☀️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtThemeText" Text="Light Mode" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Row: Hex Code + Color Picker + Apply Button + Preview -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hexadecimal Input Field -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="txtAccentLabel" Text="Accent &amp; Button Color (Hexadecimal):" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtSettingAccentColor" Text="#0EA5E9" Height="28" TextChanged="TxtSettingAccentColor_TextChanged"/>
                                    </StackPanel>

                                    <!-- Color Picker Dialog Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,8,0">
                                        <Button x:Name="btnOpenColorDialog"
                                                Content="🎨 Pick Color..."
                                                Style="{StaticResource BtnDefault}"
                                                Height="28"
                                                Padding="10,0"
                                                ToolTip="Open Windows color picker dialog"
                                                Click="BtnOpenColorDialog_Click"/>
                                    </StackPanel>

                                    <!-- Apply Color Button -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <Button x:Name="btnApplyCustomColor"
                                                Content="✔️ Apply Color"
                                                Style="{StaticResource BtnAccent}"
                                                Height="28"
                                                Padding="12,0"
                                                ToolTip="Apply the specified accent color immediately to OptiAssist"
                                                Click="BtnApplyCustomColor_Click"/>
                                    </StackPanel>

                                    <!-- Preview Box -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtPreviewLabel"
                                                   Text="Preview: "
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <Border x:Name="borderPreviewColor"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushAccent}"
                                                BorderBrush="{DynamicResource BrushBorderCard}"
                                                BorderThickness="1"
                                                ToolTip="Current accent color"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Preset Color Palette -->
                                <TextBlock x:Name="txtPresetLabel" Text="Suggested Colors:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="btnPresetBlue" Content="🔵 Blue (Default)" Tag="#0EA5E9" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetGreen" Content="🟢 Light Green" Tag="#10B981" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPurple" Content="🟣 Purple" Tag="#8B5CF6" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetOrange" Content="🟠 Orange" Tag="#F97316" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetRed" Content="🔴 Red" Tag="#FF4444" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetYellow" Content="🟡 Yellow" Tag="#F59E0B" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                    <Button x:Name="btnPresetPink" Content="🌸 Pink" Tag="#FC4899" Style="{StaticResource BtnDefault}" Height="28" Padding="10,0" Margin="0,0,6,6" FontSize="10" Click="BtnColorPreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section: Modular Add-ons & Plugins Management -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtAddonsManagerTitle"
                                                   Text="🧩 Installed Modules &amp; Plugins"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushAccent}"/>
                                        <TextBlock x:Name="txtAddonsManagerSubtitle"
                                                   Text="Manage external .dll modules stored in Config\Addons. Active modules appear directly in the sidebar menu."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button x:Name="btnAddAddon"
                                                Content="➕ Add Module"
                                                Style="{StaticResource BtnAccent}"
                                                Padding="12,0"
                                                Height="30"
                                                Margin="0,0,6,0"
                                                Click="BtnAddAddon_Click"/>
                                        <Button x:Name="btnOpenAddonsFolder"
                                                Content="📁 Open Add-ons Folder"
                                                Style="{StaticResource BtnDefault}"
                                                Padding="12,0"
                                                Height="30"
                                                Margin="0,0,6,0"
                                                Click="BtnOpenAddonsFolder_Click"/>
                                        <Button x:Name="btnReloadAddons"
                                                Content="🔄 Reload Add-ons"
                                                Style="{StaticResource BtnDefault}"
                                                Padding="12,0"
                                                Height="30"
                                                Click="BtnReloadAddons_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Discovered Addon DLLs List -->
                                <ItemsControl x:Name="icAddonsList" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgPrimary}"
                                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Icon}"
                                                               FontSize="24"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Info & AssemblyInfo Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • v" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyCompany}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                            <Border Background="{DynamicResource BrushBgCard}"
                                                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding AssemblyTitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text=" | " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyProduct}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                            <TextBlock Text=" | " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyDescription}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding AssemblyCopyright}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="  •  " FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding DisplayPath}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Reorder + Enable/Disable Switch + Remove Button -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Content="▲"
                                                                ToolTip="Mover para cima / Move up"
                                                                Style="{StaticResource BtnDefault}"
                                                                Width="26"
                                                                Height="26"
                                                                Padding="0"
                                                                FontSize="10"
                                                                Margin="0,0,4,0"
                                                                VerticalAlignment="Center"
                                                                Click="BtnMoveAddonUp_Click"/>
                                                        <Button Content="▼"
                                                                ToolTip="Mover para baixo / Move down"
                                                                Style="{StaticResource BtnDefault}"
                                                                Width="26"
                                                                Height="26"
                                                                Padding="0"
                                                                FontSize="10"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Click="BtnMoveAddonDown_Click"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ModifyControlsVisibility}">
                                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanModify}"
                                                                      Content="{Binding ActiveLabel}"
                                                                      FontSize="11"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,12,0"
                                                                      Click="AddonEnableCheckbox_Click"/>
                                                            <Button Content="{Binding RemoveLabel}"
                                                                    IsEnabled="{Binding CanModify}"
                                                                    Style="{StaticResource BtnDanger}"
                                                                    Height="26"
                                                                    Padding="10,0"
                                                                    FontSize="10"
                                                                    VerticalAlignment="Center"
                                                                    Click="BtnRemoveAddon_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="txtAddonsHelpTitle"
                                           Text="💡 How to install new add-ons"
                                           FontWeight="Bold"
                                           FontSize="10"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,2,0,2"/>
                                <TextBlock x:Name="txtAddonsHelpText"
                                           Text="Modules are compiled .NET assemblies (.dll) located in Config\Addons\&lt;ModuleName&gt;\&lt;ModuleName&gt;.dll. Enabled modules integrate directly into the sidebar navigation."
                                           FontSize="10"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ -->
                    <!-- TAB 6: ABOUT THE APPLICATION                    -->
                    <!-- ================================================ -->
                    <StackPanel x:Name="panelAbout" Visibility="Collapsed" Margin="4">
                        <!-- Header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtAboutTitle"
                                           Text="ℹ️  About"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtAboutSub"
                                           Text="Version information, open-source license terms, and official channels"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Main License and Information Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Image x:Name="imgAboutLogo"
                                           Source="app.png"
                                           Width="48"
                                           Height="48"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtAboutVersion"
                                                   Text="OptiAssist v1.2.S4"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccent}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="Copyright (C) 2026 João Figueiró"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Acknowledgments & Credits to Chris Titus -->
                                <Border Background="{DynamicResource BrushBgPrimary}"
                                        BorderBrush="{DynamicResource BrushBorderCard}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="txtAboutCreditsTitle"
                                                   Text="🤝 Acknowledgments &amp; Credits"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="txtAboutCreditsText"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   LineHeight="16"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Text="Special thanks and credit to Chris Titus Tech and the open-source community behind WinUtil, whose work served as an essential inspiration and foundation for the implementation of several system maintenance and optimization features in OptiAssist."/>
                                    </StackPanel>
                                </Border>

                                <!-- Official Links / Buttons -->
                                <WrapPanel>
                                    <Button x:Name="btnAboutGithub"
                                            Content="🐙 GitHub Repository"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutGithub_Click"/>
                                    <Button x:Name="btnAboutWebsite"
                                            Content="🌐 Official Website"
                                            Style="{StaticResource BtnAccent}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutWebsite_Click"/>
                                    <Button x:Name="btnAboutDocumentation"
                                            Content="📖 Documentation"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutDocumentation_Click"/>
                                    <Button x:Name="btnAboutLicense"
                                            Content="⚖️ License"
                                            Style="{StaticResource BtnDefault}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,8,8"
                                            Click="BtnAboutLicense_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- About Installed Modules & Plugins Summary Card -->
                        <Border Background="{DynamicResource BrushBgCard}"
                                BorderBrush="{DynamicResource BrushBorderCard}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="txtAboutAddonsTitle"
                                           Text="🧩 About Installed Modules &amp; Plugins"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushAccent}"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtAboutAddonsSubtitle"
                                           Text="Quick summary and AssemblyInfo metadata of all modular add-ons integrated into OptiAssist:"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>

                                <ItemsControl x:Name="icAboutAddonsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgPrimary}"
                                                    BorderBrush="{DynamicResource BrushBorderCard}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Icon}"
                                                               FontSize="22"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Summary + AssemblyInfo Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • v" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AssemblyVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding AssemblyProduct}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyDescription}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                            <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding AssemblyCompany}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding AssemblyCopyright}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="  •  " FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{Binding DisplayPath}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="2"
                                                            Visibility="{Binding ModifyControlsVisibility}"
                                                            Background="{DynamicResource BrushBgCard}"
                                                            BorderBrush="{DynamicResource BrushBorderCard}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushAccent}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

                <!-- ======================================================== -->
                <!-- DEDICATED TAB: OUTPUT TERMINAL & COMMAND EXECUTION       -->
                <!-- ======================================================== -->
                <Grid x:Name="panelTerminal"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top: Header with Title and Actions -->
                        <RowDefinition Height="*" />    <!-- Center: Monospace Console -->
                    </Grid.RowDefinitions>

                    <!-- Top: Title & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtLogsTitle"
                                       Text="📜  Logs"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtLogsSub"
                                       Text="Real-time log of diagnostics, scripts, and system executions"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPopoutLog"
                                    Content="🗗 Pop-out Logs"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    ToolTip="Open Logs in a separate floating window"
                                    Click="BtnPopoutLog_Click"/>
                            <Button x:Name="btnExportLog"
                                    Content="💾 Export Log"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnSaveLog_Click"/>
                            <Button x:Name="btnCopyAllLog"
                                    Content="📋 Copy All"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,6,0"
                                    Click="BtnCopyLog_Click"/>
                            <Button x:Name="btnClearLog"
                                    Content="🗑️ Clear Console"
                                    Style="{StaticResource BtnDefault}"
                                    Height="28"
                                    Padding="10,0"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Center: Monospace Console / Terminal Window -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushConsoleBg}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBox x:Name="txtConsoleLog"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Lucida Console, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushConsoleText}"
                                 BorderThickness="0"
                                 Padding="12,10"/>
                    </Border>
                </Grid>
                <!-- Module Lazy-Load Indicator Overlay -->
                <Grid x:Name="pnlAddonLoadingOverlay"
                      Background="{DynamicResource BrushBgPrimary}"
                      Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushBgCard}"
                            BorderBrush="{DynamicResource BrushBorderCard}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Width="240" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtAddonLoadingTitle"
                                       Text="⏳ Loading module..."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Foreground="{DynamicResource BrushAccent}"
                                         Background="{DynamicResource BrushBgPrimary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: BOTTOM STATUS BAR (Always Visible, Centered)      -->
        <!-- Firmware | Secure Boot | TPM | BitLocker                 -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
            Background="{DynamicResource BrushBgSidebar}"
            Padding="16,2,16,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 1. Firmware (UEFI / Legacy BIOS) -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorderCard}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtFirmwareLabel"
                                   Text="⚙️ Firmware: "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtFirmwareStatus"
                                   Text="Querying..."
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushWarning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 2. Secure Boot -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorderCard}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtSecureBootLabel"
                                   Text="⚡ Secure Boot: "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtSecureBootStatus"
                                   Text="Querying..."
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushWarning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 3. TPM (Clickable) -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorderCard}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2"
                        Margin="0,0,8,0">
                    <StackPanel x:Name="pnlTpmStatus"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                ToolTip="Click to open TPM Management console (tpm.msc)"
                                MouseLeftButtonDown="PnlTpmStatus_MouseLeftButtonDown">
                        <TextBlock x:Name="txtTpmLabel"
                                   Text="🛡️ TPM: "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTpmStatus"
                                   Text="Querying..."
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushWarning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 4. BitLocker (Clickable) -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorderCard}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2">
                    <StackPanel x:Name="pnlBitLockerStatus"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                ToolTip="Click to open BitLocker / Device Encryption settings"
                                MouseLeftButtonDown="PnlBitLockerStatus_MouseLeftButtonDown">
                        <TextBlock x:Name="txtBitLockerLabel"
                                   Text="🔒 BitLocker: "
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBitLockerStatus"
                                   Text="Querying..."
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushWarning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
</Border>
</Window>
