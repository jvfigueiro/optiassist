    {
      "id": "ui-reserved-storage-off",
      "category": "appearance_ui",
      "titleKey": "Debloat_UiReservedStorageOff_Title",
      "titleFallback": "Disable Windows Reserved Storage (Reclaim ~7 GB)",
      "descKey": "Debloat_UiReservedStorageOff_Desc",
      "descFallback": "Runs DISM /Online /Set-ReservedStorageState /State:Disabled (Build >= 18362) to reclaim space on constrained eMMC/SSD drives.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 18362,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "off",
        "workstation": "off",
        "hybrid": "off",
        "conventional": "off",
        "laptop": "off",
        "laptopGaming": "off",
        "ultraportable": "on"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ReserveManager",
          "name": "ShippedWithReserves",
          "equals": "0"
        }
      ],
      "apply": [
