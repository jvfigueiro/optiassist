    {
      "id": "ui-compact-os",
      "category": "appearance_ui",
      "titleKey": "Debloat_UiCompactOs_Title",
      "titleFallback": "Enable CompactOS Compression (SSE4.2 & Free Space < 15 GB)",
      "descKey": "Debloat_UiCompactOs_Desc",
      "descFallback": "Runs compact.exe /CompactOS:always to reclaim ~2-4 GB on small drives. Requires SSE4.2, < 15 GB free space, and explicit confirmation.",
      "risk": "medium",
      "doubleConfirm": true,
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"],
        "condition": "compact_os_eligible"
      },
      "profiles": {
        "gaming": "off",
        "workstation": "off",
        "hybrid": "off",
        "conventional": "off",
        "laptop": "off",
        "laptopGaming": "off",
        "ultraportable": "ask"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Wof",
          "name": "CompactOS",
          "equals": "1"
        }
      ],
      "apply": [
        {
          "type": "command",
          "shell": "cmd",
          "command": "compact.exe /CompactOS:always"
        }
      ],
      "revert": "from-snapshot",
      "warnings": [
        "CompactOS compresses Windows binaries and can take several minutes. Only recommended on drives with < 15 GB free and SSE4.2 CPU."
      ],
      "needsReboot": false
    }
  ]
}
