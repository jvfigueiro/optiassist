{
  "version": "2.0.F3",
  "category": "appearance_ui",
  "tweaks": [
    {
      "id": "ui-taskbar-end-task",
      "category": "appearance_ui",
      "titleKey": "Debloat_UiTaskbarEndTask_Title",
      "titleFallback": "Enable 'End Task' in Taskbar Right-Click Menu (Win11 23H2+)",
      "descKey": "Debloat_UiTaskbarEndTask_Desc",
      "descFallback": "Sets TaskbarEndTask=1 under TaskbarDeveloperSettings so frozen apps can be killed directly from the taskbar context menu.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 22631,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings",
          "name": "TaskbarEndTask",
          "equals": "1"
        }
      ],
      "apply": [
        {
          "type": "registry",
          "operation": "set",
          "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings",
          "name": "TaskbarEndTask",
          "kind": "DWord",
          "value": "1",
          "includeDefaultUser": true
        }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
