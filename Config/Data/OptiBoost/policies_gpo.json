    {
      "id": "dll-debloat-wpbt",
      "category": "policies_gpo",
      "titleKey": "Debloat_Wpbt_Title",
      "titleFallback": "Disable WPBT Execution (BIOS/OEM Bloatware) [Medium Risk]",
      "descKey": "Debloat_Wpbt_Desc",
