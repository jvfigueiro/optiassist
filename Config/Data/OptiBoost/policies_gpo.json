{
  "version": "2.0.F3",
  "category": "policies_gpo",
  "tweaks": [
    {
      "id": "dll-debloat-consumer-features",
      "category": "policies_gpo",
      "titleKey": "Debloat_ConsumerFeatures_Title",
      "titleFallback": "Disable Consumer Features & Store Suggestions (CloudContent.admx)",
      "descKey": "Debloat_ConsumerFeatures_Desc",
      "descFallback": "Prevents automatic installation of sponsored apps via CloudContent policies and disables ContentDeliveryManager suggestions for active and default users.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "equals": "1" },
        { "type": "registry", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "equals": "0" }
      ],
      "apply": [
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableCloudOptimizedContent", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableConsumerAccountStateContent", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableSoftLanding", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "ContentDeliveryAllowed", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContentEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "kind": "DWord", "value": "0", "includeDefaultUser": true }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
    {
      "id": "dll-debloat-telemetry",
      "category": "policies_gpo",
      "titleKey": "Debloat_Telemetry_Title",
      "titleFallback": "Disable Windows Telemetry & Error Reporting (ErrorReporting.admx)",
      "descKey": "Debloat_Telemetry_Desc",
      "descFallback": "Sets edition-aware AllowTelemetry (0 on Enterprise/IoT, 1 on Pro/Home), disables Advertising ID, feedback notifications, and Windows Error Reporting (Disabled=1).",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "editionAwareTelemetry": true },
        { "type": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "equals": "1" }
      ],
      "apply": [
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "editionAwareTelemetry": true },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "LoggingDisabled", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "kind": "DWord", "value": "1" },
        { "type": "registry", "operation": "set", "path": "HKU\\<SID>\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "kind": "DWord", "value": "0", "includeDefaultUser": true }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
