        "workstation": "ask",
        "hybrid": "on",
        "conventional": "off",
        "laptop": "ask",
        "laptopGaming": "ask",
        "ultraportable": "ask"
      },
      "detect": [
        { "type": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "DisableWpbtExecution", "equals": "1" }
      ],
      "apply": [
        { "type": "registry", "operation": "set", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "DisableWpbtExecution", "kind": "DWord", "value": "1" }
