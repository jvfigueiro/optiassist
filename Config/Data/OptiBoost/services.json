{
  "version": "2.0.F3",
  "category": "services",
  "tweaks": [
    {
      "id": "svc-diagtrack-wersvc",
      "category": "services",
      "titleKey": "Debloat_SvcDiagTrackWer_Title",
      "titleFallback": "Disable Telemetry & Error Reporting Services (DiagTrack & WerSvc)",
      "descKey": "Debloat_SvcDiagTrackWer_Desc",
      "descFallback": "Stops and disables Connected User Experiences and Telemetry (DiagTrack) and Windows Error Reporting (WerSvc) across all profiles.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [
        { "type": "service", "name": "DiagTrack", "equals": "4" },
        { "type": "service", "name": "WerSvc", "equals": "4" }
      ],
      "apply": [
        { "type": "service", "name": "DiagTrack", "startupType": "Disabled", "stopService": true },
        { "type": "service", "name": "WerSvc", "startupType": "Disabled", "stopService": true }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
    {
