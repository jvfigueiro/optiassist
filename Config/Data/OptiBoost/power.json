    {
      "id": "pwr-hibernation-off",
      "category": "power",
      "titleKey": "Debloat_PwrHibernateOff_Title",
      "titleFallback": "Disable Hibernation (Remove hiberfil.sys)",
      "descKey": "Debloat_PwrHibernateOff_Desc",
      "descFallback": "Runs powercfg /h off on desktops and ultraportables to reclaim gigabytes of SSD/eMMC space and avoid Fast Startup kernel issues. Never enabled on standard/gaming laptops.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "off",
        "laptopGaming": "off",
        "ultraportable": "on"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power",
          "name": "HibernateEnabled",
          "equals": "0"
        }
      ],
      "apply": [
        {
          "type": "powercfg",
          "operation": "hibernate",
          "value": "0"
        }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
    {
      "id": "pwr-mouse-accel-off",
      "category": "power",
      "titleKey": "Debloat_PwrMouseAccelOff_Title",
      "titleFallback": "Disable Mouse Acceleration (1:1 Raw Linear Curve)",
      "descKey": "Debloat_PwrMouseAccelOff_Desc",
      "descFallback": "Sets MouseSpeed=0, MouseThreshold1=0, and MouseThreshold2=0 across active and default users for consistent 1:1 aiming in games.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "ask",
        "hybrid": "on",
        "conventional": "off",
        "laptop": "off",
        "laptopGaming": "on",
        "ultraportable": "off"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseSpeed",
          "equals": "0"
        },
        {
          "type": "registry",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseThreshold1",
          "equals": "0"
        },
        {
          "type": "registry",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseThreshold2",
          "equals": "0"
        }
      ],
      "apply": [
        {
          "type": "registry",
          "operation": "set",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseSpeed",
          "kind": "String",
          "value": "0",
          "includeDefaultUser": true
        },
        {
          "type": "registry",
          "operation": "set",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseThreshold1",
          "kind": "String",
          "value": "0",
          "includeDefaultUser": true
        },
        {
          "type": "registry",
          "operation": "set",
          "path": "HKU\\<SID>\\Control Panel\\Mouse",
          "name": "MouseThreshold2",
          "kind": "String",
          "value": "0",
          "includeDefaultUser": true
        }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    }
  ]
}
