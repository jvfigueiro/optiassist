    {
      "id": "pwr-optiassist-hybrid-plan",
      "category": "power",
      "titleKey": "Debloat_PwrHybridPlan_Title",
      "titleFallback": "Create & Activate 'OptiAssist Hybrid' Power Plan",
      "descKey": "Debloat_PwrHybridPlan_Desc",
      "descFallback": "Clones the Windows Balanced plan (without overwriting it) with DISKIDLE=0, Wi-Fi Max Performance, CPU 5%-100%, AC timeouts (20m screen / never sleep/hibernate) and DC timeouts (10m / 30m / 1h).",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [],
      "apply": [
        {
          "type": "powercfg",
          "operation": "create_hybrid_plan"
        }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
    {
