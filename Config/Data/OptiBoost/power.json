    {
      "id": "pwr-overlay-best-performance",
      "category": "power",
      "titleKey": "Debloat_PwrOverlayPerf_Title",
      "titleFallback": "Set Windows Power Mode to Best Performance (AC)",
      "descKey": "Debloat_PwrOverlayPerf_Desc",
      "descFallback": "Activates the native Best Performance power overlay (ded574b5-45a0-4f42-8737-46345c09c238) while plugged in.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 17763,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "on",
        "hybrid": "on",
        "conventional": "off",
        "laptop": "off",
        "laptopGaming": "ask",
        "ultraportable": "off"
      },
      "detect": [
        {
          "type": "registry",
          "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power\\User\\PowerSchemes",
          "name": "ActiveOverlayAcPowerScheme",
          "equals": "ded574b5-45a0-4f42-8737-46345c09c238"
        }
      ],
      "apply": [
        {
          "type": "powercfg",
          "operation": "overlay_best_performance"
        }
      ],
      "revert": "from-snapshot",
      "warnings": [],
      "needsReboot": false
    },
