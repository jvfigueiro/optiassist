{
  "version": "2.0.F3",
  "category": "features_capabilities",
  "tweaks": [
    {
      "id": "cap-vbscript",
      "category": "features_capabilities",
      "titleKey": "Debloat_CapVbscript_Title",
      "titleFallback": "Uninstall VBSCRIPT Optional Capability (Win11 24H2+)",
      "descKey": "Debloat_CapVbscript_Desc",
      "descFallback": "Dynamically matches and removes the deprecated VBSCRIPT capability via Get-WindowsCapability without hardcoded version suffixes.",
      "risk": "low",
      "appliesTo": {
        "minBuild": 26100,
        "maxBuild": 0,
        "editions": ["*"],
        "formFactors": ["desktop", "laptop", "ultraportable"]
      },
      "profiles": {
        "gaming": "on",
        "workstation": "ask",
        "hybrid": "on",
        "conventional": "on",
        "laptop": "on",
        "laptopGaming": "on",
        "ultraportable": "on"
      },
      "detect": [],
      "apply": [
        { "type": "capability", "pattern": "*VBSCRIPT*", "state": "Remove" }
      ],
      "revert": "manual",
      "warnings": [],
      "needsReboot": false
    },
